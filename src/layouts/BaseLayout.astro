---
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { getSettings } from '../lib/content';
import { localBusiness, website } from '../lib/schema';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** True for pages that open with a full-bleed photo (transparent header). */
  overlayHeader?: boolean;
  noindex?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
}
const { title, description, image, imageAlt, overlayHeader = false, noindex = false, jsonLd = [], type } = Astro.props;
const settings = await getSettings();
const siteUrl = new URL('/', Astro.site!).toString();

// LocalBusiness + WebSite are emitted on every page so search engines always see who we are and where we work.
const baseLd = [localBusiness(settings, siteUrl), website(settings, siteUrl)];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf7f2" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <SEO title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex} type={type} jsonLd={[...baseLd, ...jsonLd]} />
    <!-- Marks the document so reveal animations only apply when JS is available -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="sr-only-focusable fixed left-3 top-3 z-[100] bg-ink px-4 py-3 text-sm font-semibold text-cream">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <FloatingWhatsApp />

    <script>
      // Gentle scroll reveals. Elements are visible by default if IntersectionObserver is missing.
      const items = document.querySelectorAll<HTMLElement>('.reveal, .reveal-img');
      if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
