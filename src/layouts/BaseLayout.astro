---
import type { ImageMetadata } from 'astro';
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingEnquire from '../components/FloatingEnquire.astro';
import { getImage } from 'astro:assets';
import { getSettings, getHome, getServices } from '../lib/content';
import { localBusiness, website } from '../lib/schema';
// Preload only the two above-the-fold faces (Latin subset). Vite hashes these exactly as the @font-face rules do.
import bodoniUrl from '@fontsource-variable/bodoni-moda/files/bodoni-moda-latin-opsz-normal.woff2?url';
import sansUrl from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  /** True for pages that open with a full-bleed photo (transparent header). */
  overlayHeader?: boolean;
  noindex?: boolean;
  /** The floating Enquire button is hidden on internal tool pages where it could cover controls. */
  floatingEnquire?: boolean;
  jsonLd?: object[];
  type?: 'website' | 'article';
}
const { title, description, image: pageImage, imageAlt: pageImageAlt, overlayHeader = false, noindex = false, floatingEnquire = true, jsonLd = [], type } = Astro.props;
const settings = await getSettings();
const siteUrl = new URL('/', Astro.site!).toString();

// Every page gets a social-preview image: its own if it has one, otherwise the homepage hero.
const home = await getHome();
const image = pageImage ?? home.hero.image;
const imageAlt = pageImage ? pageImageAlt : home.hero.imageAlt;
const businessImage = new URL((await getImage({ src: home.hero.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' })).src, siteUrl).toString();
const services = await getServices();

// LocalBusiness + WebSite are emitted on every page so search engines always see who we are and where we work.
const baseLd = [
  localBusiness(settings, siteUrl, businessImage, services.map((s) => ({ name: s.data.title, description: s.data.summary, url: `${siteUrl}services/${s.id}/` }))),
  website(settings, siteUrl),
];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#faf7f2" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={bodoniUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={sansUrl} crossorigin />
    <SEO title={title} description={description} image={image} imageAlt={imageAlt} noindex={noindex} type={type} jsonLd={[...baseLd, ...jsonLd]} />
    <!-- Marks the document so reveal animations only apply when JS is available -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="sr-only-focusable fixed left-3 top-3 z-[100] bg-ink px-4 py-3 text-sm font-semibold text-cream">Skip to content</a>
    <Header overlay={overlayHeader} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {floatingEnquire && <FloatingEnquire />}

    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
