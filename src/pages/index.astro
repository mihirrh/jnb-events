---
import BaseLayout from '../layouts/BaseLayout.astro';
import Img from '../components/Img.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { getHome, getServices, getProjects, getPublishedTestimonials, getSettings } from '../lib/content';
import { serviceList } from '../lib/schema';
import { emphasis, plain } from '../lib/text';

const home = await getHome();
const settings = await getSettings();
const services = await getServices();
const featured = (await getProjects()).filter((p) => p.data.featured).slice(0, 5);
const [opener, ...collage] = featured;
const testimonials = await getPublishedTestimonials();
const site = Astro.site!.toString();

// Placement of the collage below the full-bleed opener (desktop): [grid classes, aspect ratio].
const layout: [string, number][] = [
  ['lg:col-span-5 lg:col-start-2', 4 / 5],
  ['lg:col-span-4 lg:col-start-8 lg:mt-44', 4 / 5],
  ['lg:col-span-6 lg:col-start-1 lg:-mt-12', 3 / 2],
  ['lg:col-span-4 lg:col-start-9 lg:mt-20', 1],
];

const [lead, ...rest] = home.intro.body.split(/\n\s*\n/);
const featureServices = services.slice(0, 2);
const rowServices = services.slice(2);
---

<BaseLayout
  title={home.seo.title}
  description={home.seo.description}
  image={home.hero.image}
  imageAlt={home.hero.imageAlt}
  overlayHeader
  jsonLd={[serviceList(services.map((s) => ({ name: s.data.title, url: `${site}services/${s.id}/` })))]}
>
  <!-- ============================== HERO ==============================
       Full-bleed photograph, headline anchored bottom-left at monumental scale, and a ruled
       "colophon" row beneath it. -->
  <section class="on-dark relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-night text-cream">
    <div class="hero-zoom absolute inset-0 -z-10">
      <Img src={home.hero.image} alt={home.hero.imageAlt} sizes="100vw" priority widths={[480, 768, 1100, 1600, 2400]} class="!aspect-auto h-full w-full" />
      <div class="absolute inset-0 bg-gradient-to-t from-night via-night/60 via-50% to-night/25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-night/65 via-night/20 via-55% to-transparent"></div>
      <div class="absolute inset-x-0 top-0 h-44 bg-gradient-to-b from-night/70 to-transparent"></div>
    </div>

    <div class="wrap relative mt-auto w-full pb-24 pt-32 md:pb-14 md:pt-36">
      <p class="eyebrow hero-in" style="--d:100ms">{home.hero.eyebrow}</p>
      <h1 class="display hero-in mt-6 max-w-[11ch] md:mt-8 md:max-w-[12ch] lg:max-w-[14ch]" style="--d:220ms" aria-label={plain(home.hero.headline)} set:html={emphasis(home.hero.headline)} />

      <div class="hero-in mt-10 grid gap-8 border-t border-cream/25 pt-8 md:mt-14 lg:grid-cols-12 lg:items-end" style="--d:420ms">
        <p class="lead max-w-md !text-cream/90 lg:col-span-5">{home.hero.subheading}</p>
        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-7 lg:justify-end">
          <WhatsAppButton label={home.hero.primaryCta.label} message={home.hero.primaryCta.message} variant="ink" source="homepage hero" class="w-full sm:w-auto" />
          <a href="/gallery/" class="btn btn-line w-full sm:w-auto">{home.hero.secondaryCtaLabel}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- =========================== BRAND STATEMENT ===========================
       Asymmetric: a tall photograph at the left, a smaller second photograph overlapping it and
       breaking out of the column, the standfirst set large in the serif on the right. -->
  <section class="section relative overflow-hidden bg-cream" aria-labelledby="intro-heading">
    <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="relative pb-16 lg:col-span-5 lg:pb-32">
        <div class="max-w-md lg:max-w-none">
          <Img src={home.intro.image} alt={home.intro.imageAlt} ratio={3 / 4} sizes="(min-width:1024px) 38vw, 90vw" class="parallax" reveal />
        </div>
        <div class="absolute bottom-0 right-0 w-[48%] max-w-[16rem] border-[10px] border-cream sm:right-8 lg:-right-16 lg:w-[52%] lg:max-w-none">
          <Img src={home.intro.secondImage} alt={home.intro.secondImageAlt} ratio={4 / 5} sizes="(min-width:1024px) 20vw, 44vw" reveal delay={250} />
        </div>
      </div>

      <div class="lg:col-span-6 lg:col-start-7 lg:pt-16">
        <div class="folio"><b>01</b><span>{home.intro.eyebrow}</span><i aria-hidden="true"></i></div>
        <h2 id="intro-heading" class="h2 reveal mt-10" aria-label={plain(home.intro.heading)} set:html={emphasis(home.intro.heading)} />
        <p class="standfirst reveal mt-10" style="--d:100ms">{lead}</p>
        <div class="reveal mt-8 grid gap-4 text-[1.02rem] text-ink-soft md:grid-cols-12" style="--d:160ms">
          <div class="space-y-4 md:col-span-9">{rest.map((p) => <p>{p}</p>)}</div>
        </div>
        <a href="/about/" class="link-arrow reveal mt-10" style="--d:200ms">
          <span>{home.intro.linkLabel}</span><span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ================================ SERVICES ================================
       Dark. Two photographic features, offset against each other, then a ruled index of the rest. -->
  <section class="on-dark section bg-night text-cream" aria-labelledby="services-heading">
    <div class="wrap">
      <div class="folio"><b>02</b><span>{home.services.eyebrow}</span><i aria-hidden="true"></i></div>
      <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
        <h2 id="services-heading" class="h2 reveal lg:col-span-8" aria-label={plain(home.services.heading)} set:html={emphasis(home.services.heading)} />
        <p class="lead reveal lg:col-span-3 lg:col-start-10">{home.services.intro}</p>
      </div>

      <div class="mt-16 grid gap-16 lg:mt-24 lg:grid-cols-12 lg:gap-8">
        {
          featureServices.map((s, i) => (
            <ServiceCard
              service={s}
              index={i}
              variant="feature"
              ratio={i === 0 ? 4 / 5 : 1}
              sizes="(min-width:1024px) 42vw, 92vw"
              class={i === 0 ? 'lg:col-span-6' : 'lg:col-span-5 lg:col-start-8 lg:mt-48'}
            />
          ))
        }
      </div>

      <div class="mt-24 lg:mt-36">
        {rowServices.map((s, i) => <ServiceCard service={s} index={i + 2} variant="row" />)}
        <div class="border-t border-gold/25"></div>
      </div>

      <!-- WhatsApp CTA directly after services -->
      <div class="reveal mt-20 grid items-end gap-8 lg:mt-28 lg:grid-cols-12">
        <div class="lg:col-span-8">
          <h3 class="h2 !text-[clamp(2.1rem,4vw+0.5rem,4.2rem)]" set:html={emphasis(home.services.ctaHeading)} />
          <p class="lead mt-5 max-w-xl">{home.services.ctaText}</p>
        </div>
        <div class="lg:col-span-4 lg:text-right">
          <WhatsAppButton label="Chat on WhatsApp" message={home.services.ctaMessage} variant="ink" source="homepage services" class="w-full sm:w-auto" />
        </div>
      </div>
    </div>
  </section>

  <!-- =============================== FEATURED WORK ===============================
       Opens with one full-bleed photograph, then a collage of overlapping / offset plates. -->
  {
    opener && (
      <section class="bg-cream pb-[clamp(5rem,11vw,11rem)]" aria-labelledby="featured-heading">
        <a href={`/gallery/${opener.id}/`} class="group relative block no-underline" aria-label={`${opener.data.title} - ${opener.data.category}`}>
          <Img
            src={opener.data.images[0].image}
            alt={opener.data.images[0].alt}
            ratio={3 / 2}
            sizes="100vw"
            widths={[640, 1100, 1600, 2400]}
            class="media-zoom !aspect-[4/5] sm:!aspect-[16/9] lg:!aspect-[21/9]"
            reveal
          />
          <span class="cap">{opener.data.category} &mdash; {opener.data.title}</span>
        </a>

        <div class="wrap mt-20 md:mt-28">
          <div class="folio"><b>03</b><span>{home.featured.eyebrow}</span><i aria-hidden="true"></i></div>
          <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
            <h2 id="featured-heading" class="h2 reveal lg:col-span-7" aria-label={plain(home.featured.heading)} set:html={emphasis(home.featured.heading)} />
            <div class="lg:col-span-4 lg:col-start-9">
              <p class="lead reveal">{home.featured.intro}</p>
              <a href="/gallery/" class="link-arrow mt-6">
                <span>{home.featured.linkLabel}</span><span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          {collage.length > 0 && (
            <div class="mt-16 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:mt-24 lg:grid-cols-12 lg:gap-y-0">
              {collage.map((p, i) => {
                const [cls, ratio] = layout[i] ?? layout[0];
                return (
                  <ProjectCard
                    project={p}
                    index={i + 1}
                    ratio={ratio}
                    class={cls}
                    delay={(i % 2) * 120}
                    sizes="(min-width:1024px) 40vw, (min-width:640px) 48vw, 94vw"
                  />
                );
              })}
            </div>
          )}
        </div>
      </section>
    )
  }

  <!-- ============================= WHERE WE WORK =============================
       Local SEO in plain sight: genuine service areas, typographic and static. -->
  <section class="relative overflow-hidden bg-cream-deep section-tight" aria-labelledby="areas-heading">
    <div class="wrap py-6 md:py-12">
      <div class="grid items-end gap-8 lg:grid-cols-12">
        <div class="lg:col-span-4">
          <div class="folio"><b>04</b><span>Where we work</span></div>
          <p class="mt-6 max-w-xs text-[0.98rem] text-ink-soft">{settings.serviceAreaNote}</p>
        </div>
        <h2 id="areas-heading" class="h2 lg:col-span-8" aria-label={settings.serviceAreas.join(', ')}>
          {
            settings.serviceAreas.map((a, i) => (
              <>
                <span class="block">{i === settings.serviceAreas.length - 1 && settings.serviceAreas.length > 1 ? <em>&amp; </em> : null}{a}{i < settings.serviceAreas.length - 2 ? ',' : ''}</span>
              </>
            ))
          }
        </h2>
      </div>
    </div>
  </section>

  <Testimonials items={testimonials} eyebrow={home.testimonials.eyebrow} heading={home.testimonials.heading} />

  <CtaBand
    eyebrow={home.cta.eyebrow}
    heading={home.cta.heading}
    text={home.cta.text}
    image={home.cta.image}
    imageAlt={home.cta.imageAlt}
    label={home.cta.label}
    message={home.cta.message}
    source="homepage footer banner"
  />
</BaseLayout>
