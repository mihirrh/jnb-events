---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Icon from '../../components/Icon.astro';
import Motif from '../../components/Motif.astro';
import { getAreas, getProjects, getSettings } from '../../lib/content';
import { breadcrumbs, faqPage, service as serviceSchema } from '../../lib/schema';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const areas = await getAreas();
  return areas.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, others: areas.filter((a) => a.id !== entry.id) },
  }));
}

const { entry, others } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const settings = await getSettings();
const site = Astro.site!.toString();
const url = `${site}areas/${entry.id}/`;

// Show related featured mandap/decor projects
const projects = (await getProjects()).slice(0, 3);
const ogImg = await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  image={data.image}
  imageAlt={data.imageAlt}
  jsonLd={[
    serviceSchema({
      settings,
      siteUrl: site,
      name: `${data.serviceType} in ${data.city}`,
      description: data.seo.description,
      url,
      image: new URL(ogImg.src, site).toString(),
    }),
    faqPage(data.faq),
    breadcrumbs([
      { name: 'Home', url: site },
      { name: 'Areas', url: `${site}areas/` },
      { name: `${data.city} - ${data.serviceType}`, url },
    ]),
  ]}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-cream pt-28 md:pt-40">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[0.18em] text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ink">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/areas/" class="hover:text-ink">Areas</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{data.city}</li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7 lg:pt-10">
          <div class="folio hero-in"><span>{data.eyebrow}</span><i aria-hidden="true"></i></div>
          <h1 class="h1 hero-in mt-8 !text-[clamp(2.5rem,5.5vw+0.4rem,5.8rem)]" style="--d:80ms">{data.h1}</h1>
          
          <div class="hero-in mt-5 flex items-center gap-4" style="--d:120ms" aria-hidden="true">
            <div class="h-px w-10 bg-line"></div>
            <Motif variant="floral" size={34} class="opacity-45" />
            <div class="h-px flex-1 bg-line"></div>
          </div>

          <p class="standfirst hero-in mt-5 max-w-xl" style="--d:160ms">{data.lead}</p>
          
          <div class="hero-in mt-10 flex flex-col gap-3 sm:flex-row" style="--d:240ms">
            <WhatsAppButton label="Enquire on WhatsApp" message={data.whatsappMessage} variant="ink" source={`${data.city} landing page`} class="w-full sm:w-auto" />
            <a href="/contact/" class="btn btn-line w-full sm:w-auto">Send an enquiry</a>
          </div>

          <p class="mt-8 flex items-center gap-2 text-sm text-muted">
            <Icon name="pin" size={16} class="shrink-0 text-gold-deep" />
            <span>{data.distanceNote}</span>
          </p>
        </div>

        <div class="relative lg:col-span-5 lg:-mr-14 xl:-mr-[min(9rem,max(3.5rem,calc((100vw-88rem)/2+3.5rem)))]">
          <Img src={data.image} alt={data.imageAlt} ratio={4 / 5} sizes="(min-width:1024px) 40vw, 94vw" priority widths={[480, 800, 1100, 1600]} class="hero-zoom" />
        </div>
      </div>
    </div>
  </section>

  <!-- Content & Key Features -->
  <section class="section bg-cream">
    <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-8">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <div class="folio"><span>Service Highlights</span><i aria-hidden="true"></i></div>
          <ul class="mt-6 space-y-3">
            {
              data.keyFeatures.map((k, i) => (
                <li class="flex items-baseline gap-4 border-b border-line py-3">
                  <span class="numeral-sm text-lg text-gold-deep" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[0.98rem] text-ink">{k}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>

      <div class="lg:col-span-7 lg:col-start-6">
        <div class="prose-jnb text-[1.08rem] text-ink-soft"><Content /></div>
        {
          data.secondImage && (
            <div class="relative mt-16 lg:-ml-24 lg:mt-24 lg:w-[calc(100%+6rem)]">
              <Img src={data.secondImage} alt={data.secondImageAlt ?? ''} ratio={3 / 2} sizes="(min-width:1024px) 56vw, 94vw" reveal />
              <span class="cap">{data.city} &mdash; {data.serviceType}</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- Popular Venues Section -->
  <section class="section bg-cream-deep" aria-labelledby="venues-heading">
    <div class="wrap">
      <div class="folio"><span>{data.city} & {data.region}</span><i aria-hidden="true"></i></div>
      <div class="mt-8 grid gap-8 lg:grid-cols-12 lg:items-end">
        <h2 id="venues-heading" class="h2 lg:col-span-7">Prominent venues in <em>{data.city}</em></h2>
        <p class="lead lg:col-span-5">We provide styling, mandap staging, and entertainment at major Asian wedding venues across {data.city} and {data.region}.</p>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          data.venues.map((v) => (
            <div class="border border-line bg-cream p-6">
              <h3 class="font-serif text-xl text-ink">{v.name}</h3>
              <p class="mt-3 text-sm leading-relaxed text-ink-soft">{v.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Location Specific FAQ Section -->
  <section class="section bg-cream" aria-labelledby="faq-heading">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <div class="folio"><span>FAQ</span><i aria-hidden="true"></i></div>
          <h2 id="faq-heading" class="h2 mt-8">Questions about <em>{data.city}</em> styling</h2>
        </div>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        {
          data.faq.map((item) => (
            <details class="group border-t border-line last:border-b">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                <h3 class="font-serif text-[clamp(1.2rem,1vw+1rem,1.55rem)] leading-snug">{item.question}</h3>
                <span aria-hidden="true" class="shrink-0 text-2xl text-gold-deep transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <p class="max-w-prose pb-6 pr-10 text-ink-soft">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Showcase Gallery Preview -->
  {
    projects.length > 0 && (
      <section class="section bg-cream-deep" aria-labelledby="work-heading">
        <div class="wrap">
          <div class="grid gap-8 lg:grid-cols-12 lg:items-end">
            <div class="lg:col-span-8">
              <div class="folio"><span>Portfolio</span><i aria-hidden="true"></i></div>
              <h2 id="work-heading" class="h2 mt-6">Recent <em>mandap & stage</em> styling</h2>
            </div>
            <div class="lg:col-span-4 lg:text-right">
              <a href="/gallery/" class="link-arrow"><span>Explore full gallery</span><span aria-hidden="true">&rarr;</span></a>
            </div>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-3">
            {projects.map((p, i) => <ProjectCard project={p} index={i} ratio={4 / 5} delay={i * 90} />)}
          </div>
        </div>
      </section>
    )
  }

  <!-- Other Areas Covered -->
  {
    others.length > 0 && (
      <section class="section-tight bg-cream" aria-labelledby="other-areas-heading">
        <div class="wrap">
          <div class="folio"><span id="other-areas-heading">Other regions we cover</span><i aria-hidden="true"></i></div>
          <ul class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-3">
            {
              others.map((a) => (
                <li class="border-b border-line">
                  <a href={`/areas/${a.id}/`} class="flex min-h-16 items-center justify-between gap-3 py-3 no-underline hover:text-gold-deep">
                    <span class="font-serif text-xl">{a.data.city} &mdash; {a.data.serviceType}</span>
                    <Icon name="arrow" size={18} />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </section>
    )
  }

  <CtaBand
    eyebrow="Bespoke Quote"
    heading={`Planning a wedding in *${data.city}?*`}
    text="Message us on WhatsApp with your date and venue to check availability."
    message={data.whatsappMessage}
    source={`${data.city} landing page`}
  />
</BaseLayout>
