---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Img from '../../components/Img.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getSimplePage, getServices } from '../../lib/content';
import { breadcrumbs, serviceList } from '../../lib/schema';

const { data: page } = await getSimplePage('services');
const services = await getServices();
const site = Astro.site!.toString();

---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={services[0].data.image}
  imageAlt={services[0].data.imageAlt}
  jsonLd={[
    breadcrumbs([{ name: 'Home', url: site }, { name: 'Services', url: `${site}services/` }]),
    serviceList(services.map((s) => ({ name: s.data.title, url: `${site}services/${s.id}/` }))),
  ]}
>
  <PageHero folio="02" eyebrow={page.eyebrow} heading={page.heading} lead={page.lead} />

  <section class="bg-cream pb-[clamp(3rem,6vw,6rem)]" aria-label="All services">
    <div class="wrap">
      <ol>
        {
          services.map((s, i) => {
            const n = String(i + 1).padStart(2, '0');
            return (
              <li class="group grid items-start gap-x-8 gap-y-5 border-t border-line py-8 md:grid-cols-12 md:py-8 lg:py-10">
                <a href={`/services/${s.id}/`} class="block no-underline md:col-span-4 lg:col-span-3" tabindex="-1" aria-hidden="true">
                  <Img src={s.data.image} alt="" ratio={3 / 2} sizes="(min-width:1024px) 24vw, (min-width:768px) 30vw, 94vw" widths={[320, 480, 640]} class="media-zoom" reveal />
                </a>
                <div class="grid gap-x-8 gap-y-4 md:col-span-8 lg:col-span-9 lg:grid-cols-9">
                  <div class="lg:col-span-5">
                    <p class="numeral-sm text-lg" aria-hidden="true">{n}</p>
                    <h2 class="h3 mt-2 !text-[clamp(1.9rem,2.2vw+1rem,3rem)]">
                      <a href={`/services/${s.id}/`} class="no-underline">{s.data.title}</a>
                    </h2>
                    <p class="mt-3 max-w-md text-[1rem] text-ink-soft">{s.data.summary}</p>
                  </div>
                  <div class="lg:col-span-4 lg:pt-7">
                    <ul class="space-y-2 text-sm text-muted">
                      {s.data.keyPoints.slice(0, 3).map((k) => (
                        <li class="flex gap-3"><span class="mt-[0.8em] h-px w-4 shrink-0 bg-gold"></span><span>{k}</span></li>
                      ))}
                    </ul>
                    <a href={`/services/${s.id}/`} class="link-arrow mt-4">
                      <span>Explore<span class="sr-only"> {s.data.title}</span></span><span aria-hidden="true">&rarr;</span>
                    </a>
                  </div>
                </div>
              </li>
            );
          })
        }
      </ol>
      <div class="border-t border-line"></div>
    </div>
  </section>

  <CtaBand
    eyebrow="Bespoke packages"
    heading="Tell us about *your event.*"
    text="Share your date, venue and what you have in mind on WhatsApp and we will suggest a package that suits."
    source="services page"
  />
</BaseLayout>
