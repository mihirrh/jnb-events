---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import Sprig from '../../components/Sprig.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Icon from '../../components/Icon.astro';
import { getServices, getProjects, getSettings, slugify } from '../../lib/content';
import { breadcrumbs, service as serviceSchema } from '../../lib/schema';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, others: services.filter((s) => s.id !== entry.id) },
  }));
}

const { entry, others, next } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const settings = await getSettings();
const site = Astro.site!.toString();
const url = `${site}services/${entry.id}/`;

const related = data.relatedCategory
  ? (await getProjects()).filter((p) => p.data.category === data.relatedCategory).slice(0, 3)
  : [];

const ogImg = await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  image={data.image}
  imageAlt={data.imageAlt}
  jsonLd={[
    serviceSchema({ settings, siteUrl: site, name: data.title, description: data.seo.description, url, image: new URL(ogImg.src, site).toString() }),
    breadcrumbs([
      { name: 'Home', url: site },
      { name: 'Services', url: `${site}services/` },
      { name: data.title, url },
    ]),
  ]}
>
  <section class="relative overflow-hidden bg-cream pt-32 md:pt-40">
    <Sprig class="pointer-events-none absolute right-4 top-24 hidden h-64 text-gold/45 lg:block" />
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ink">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/services/" class="hover:text-ink">Services</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{data.title}</li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-7">
          <h1 class="h1 hero-in">{data.title}</h1>
          <p class="lead hero-in mt-7 max-w-2xl" style="--d:120ms">{data.lead}</p>
          <div class="hero-in mt-9 flex flex-col gap-4 sm:flex-row" style="--d:220ms">
            <WhatsAppButton label="Enquire on WhatsApp" message={data.whatsappMessage} variant="ink" source={`${data.title} page`} class="w-full sm:w-auto" />
            <a href="/contact/" class="btn btn-line w-full sm:w-auto">Send an enquiry</a>
          </div>
        </div>
        <div class="lg:col-span-5">
          <p class="eyebrow">Based in {settings.location.locality}</p>
          <p class="mt-3 text-sm text-muted">{settings.serviceAreaNote}</p>
        </div>
      </div>

      <div class="mt-14">
        <Img src={data.image} alt={data.imageAlt} ratio={16 / 9} sizes="(min-width:1280px) 1180px, 94vw" priority widths={[640, 960, 1280, 1800]} class="hero-zoom" />
      </div>
    </div>
  </section>

  <section class="section-tight bg-cream">
    <div class="wrap grid gap-14 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 class="h3 border-t border-gold pt-6">What is included</h2>
        <ul class="mt-6 space-y-4">
          {
            data.keyPoints.map((k) => (
              <li class="flex gap-4">
                <Icon name="check" size={20} class="mt-1 shrink-0 text-gold-deep" />
                <span class="text-[1.02rem]">{k}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="lg:col-span-7">
        <div class="prose-jnb text-[1.05rem] text-ink-soft"><Content /></div>
        {
          data.secondImage && (
            <div class="mt-12 max-w-xl">
              <Img src={data.secondImage} alt={data.secondImageAlt ?? ''} ratio={4 / 3} sizes="(min-width:1024px) 40vw, 90vw" reveal />
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section-tight bg-cream-deep" aria-labelledby="related-heading">
        <div class="wrap">
          <div class="flex flex-col justify-between gap-4 md:flex-row md:items-end">
            <h2 id="related-heading" class="h2">Recent {data.title.toLowerCase()} work</h2>
            <a href={`/gallery/category/${slugify(data.relatedCategory!)}/`} class="link-arrow self-start">
              <span>See all</span><span aria-hidden="true">&rarr;</span>
            </a>
          </div>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((p, i) => <ProjectCard project={p} delay={i * 90} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand
    eyebrow="Enquire"
    heading={`Planning ${data.title.toLowerCase()}?`}
    text="Send us your date, venue and ideas on WhatsApp and we will come back to you."
    message={data.whatsappMessage}
    source={`${data.title} page`}
  />

  <section class="section-tight bg-cream" aria-labelledby="more-heading">
    <div class="wrap">
      <h2 id="more-heading" class="eyebrow">More services</h2>
      <ul class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.slice(0, 8).map((s) => (
            <li class="border-t border-line">
              <a href={`/services/${s.id}/`} class="flex min-h-14 items-center justify-between gap-3 py-3 no-underline hover:text-gold-deep">
                <span class="font-serif text-xl">{s.data.title}</span>
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
