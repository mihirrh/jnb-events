---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Icon from '../../components/Icon.astro';
import Motif from '../../components/Motif.astro';
import { getServices, getProjects, getSettings, slugify } from '../../lib/content';
import { breadcrumbs, service as serviceSchema } from '../../lib/schema';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const services = await getServices();
  return services.map((entry) => ({
    params: { slug: entry.id },
    props: { entry, others: services.filter((s) => s.id !== entry.id) },
  }));
}

const { entry, others } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const settings = await getSettings();
const site = Astro.site!.toString();
const url = `${site}services/${entry.id}/`;

const related = data.relatedCategory
  ? (await getProjects()).filter((p) => p.data.category === data.relatedCategory).slice(0, 2)
  : [];

const ogImg = await getImage({ src: data.image, width: 1200, height: 630, format: 'jpg', fit: 'cover' });
---

<BaseLayout
  title={data.seo.title}
  description={data.seo.description}
  image={data.image}
  imageAlt={data.imageAlt}
  jsonLd={[
    serviceSchema({ settings, siteUrl: site, name: data.title, description: data.seo.description, url, image: new URL(ogImg.src, site).toString() }),
    breadcrumbs([
      { name: 'Home', url: site },
      { name: 'Services', url: `${site}services/` },
      { name: data.title, url },
    ]),
  ]}
>
  <!-- Opening spread: title and standfirst at left, a tall photograph hanging from the top-right,
       breaking out of the text column. -->
  <section class="relative overflow-hidden bg-cream pt-28 md:pt-40">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[0.18em] text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="hover:text-ink">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/services/" class="hover:text-ink">Services</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{data.title}</li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-12 lg:grid-cols-12 lg:gap-8">
        <div class="lg:col-span-7 lg:pt-10">
          <div class="folio hero-in"><span>Based in {settings.location.locality}</span><i aria-hidden="true"></i></div>
          <h1 class="h1 hero-in mt-8 !text-[clamp(2.7rem,6vw+0.4rem,6.4rem)]" style="--d:80ms">{data.title}</h1>
          <!-- Motif accent: sits quietly between the title and the standfirst -->
          <div class="hero-in mt-5 flex items-center gap-4" style="--d:120ms" aria-hidden="true">
            <div class="h-px w-10 bg-line"></div>
            <Motif variant="floral" size={34} class="opacity-45" />
            <div class="h-px flex-1 bg-line"></div>
          </div>
          <p class="standfirst hero-in mt-5 max-w-xl" style="--d:160ms">{data.lead}</p>
          <div class="hero-in mt-10 flex flex-col gap-3 sm:flex-row" style="--d:240ms">
            <WhatsAppButton label="Enquire on WhatsApp" message={data.whatsappMessage} variant="ink" source={`${data.title} page`} class="w-full sm:w-auto" />
            <a href="/contact/" class="btn btn-line w-full sm:w-auto">Send an enquiry</a>
          </div>
          <p class="mt-8 max-w-sm text-sm text-muted">{settings.serviceAreaNote}</p>
        </div>
        <div class="relative lg:col-span-5 lg:-mr-14 xl:-mr-[min(9rem,max(3.5rem,calc((100vw-88rem)/2+3.5rem)))]">
          <Img src={data.image} alt={data.imageAlt} ratio={4 / 5} sizes="(min-width:1024px) 40vw, 94vw" priority widths={[480, 800, 1100, 1600]} class="hero-zoom" />
        </div>
      </div>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-8">
      <aside class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <div class="folio"><span>What is included</span><i aria-hidden="true"></i></div>
          <ul class="mt-6">
            {
              data.keyPoints.map((k, i) => (
                <li class="flex items-baseline gap-5 border-b border-line py-4">
                  <span class="numeral-sm text-xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                  <span class="text-[1.02rem]">{k}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
      <div class="lg:col-span-7 lg:col-start-6">
        <div class="prose-jnb text-[1.08rem] text-ink-soft"><Content /></div>
        {
          data.secondImage && (
            <div class="relative mt-16 lg:-ml-24 lg:mt-24 lg:w-[calc(100%+6rem)]">
              <Img src={data.secondImage} alt={data.secondImageAlt ?? ''} ratio={3 / 2} sizes="(min-width:1024px) 56vw, 94vw" reveal />
              <span class="cap">{data.title}</span>
            </div>
          )
        }
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <>
      <!-- Motif transition between content and related work -->
      <div class="flex justify-center bg-cream py-6" aria-hidden="true">
        <Motif variant="line" size={44} class="opacity-35" />
      </div>
      <section class="section bg-cream-deep" aria-labelledby="related-heading">
        <div class="wrap">
          <div class="grid gap-10 lg:grid-cols-12 lg:gap-8">
            <div class="lg:col-span-4">
              <h2 id="related-heading" class="h2 !text-[clamp(2rem,3vw+0.5rem,3.4rem)]">Recent <em>{data.title.toLowerCase()}</em> work</h2>
              <a href={`/gallery/category/${slugify(data.relatedCategory!)}/`} class="link-arrow mt-6">
                <span>See all</span><span aria-hidden="true">&rarr;</span>
              </a>
            </div>
            <div class:list={['grid gap-8 lg:col-span-8', related.length > 1 && 'sm:grid-cols-2']}>
              {related.map((p, i) => <ProjectCard project={p} index={i} ratio={related.length > 1 ? 4 / 5 : 3 / 2} delay={i * 90} />)}
            </div>
          </div>
        </div>
      </section>
      </>
    )
  }

  <CtaBand
    eyebrow="Enquire"
    heading={`Planning *${data.title.toLowerCase()}?*`}
    text="Send us your date, venue and ideas on WhatsApp and we will come back to you."
    message={data.whatsappMessage}
    source={`${data.title} page`}
  />

  <section class="section-tight bg-cream" aria-labelledby="more-heading">
    <div class="wrap">
      <div class="folio"><span id="more-heading">More services</span><i aria-hidden="true"></i></div>
      <ul class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          others.slice(0, 8).map((s) => (
            <li class="border-b border-line">
              <a href={`/services/${s.id}/`} class="flex min-h-16 items-center justify-between gap-3 py-3 no-underline hover:text-gold-deep">
                <span class="font-serif text-xl">{s.data.title}</span>
                <Icon name="arrow" size={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>
