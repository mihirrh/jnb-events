---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import { getAbout, getServices, getSettings } from '../lib/content';
import { breadcrumbs } from '../lib/schema';
import { emphasis } from '../lib/text';

const page = await getAbout();
const services = await getServices();
const settings = await getSettings();
const site = Astro.site!.toString();
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.image}
  imageAlt={page.imageAlt}
  jsonLd={[breadcrumbs([{ name: 'Home', url: site }, { name: 'About', url: `${site}about/` }])]}
>
  <PageHero folio="04" eyebrow={page.eyebrow} heading={page.heading} lead={page.lead} />

  <!-- Portrait photograph bleeding off the left edge; text and a small inset image at the right -->
  <section class="bg-cream pb-[clamp(5rem,10vw,10rem)]">
    <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="relative lg:col-span-6">
        <div class="arch-line -right-5 top-8 hidden h-[70%] w-[70%] lg:block" aria-hidden="true"></div>
        <div class="arch">
          <Img src={page.image} alt={page.imageAlt} ratio={3 / 4} sizes="(min-width:1024px) 46vw, 94vw" class="parallax" reveal />
        </div>
      </div>
      <div class="lg:col-span-5 lg:col-start-8 lg:pt-32">
        <p class="standfirst reveal">
          Based in {settings.location.locality} and covering {settings.location.region} and the rest of the UK, we deliver premium-quality styling and entertainment at competitive prices.
        </p>
        <div class="relative mt-14 lg:-ml-32">
          <Img src={page.secondImage} alt={page.secondImageAlt} ratio={4 / 3} sizes="(min-width:1024px) 34vw, 94vw" reveal delay={150} />
          <span class="cap">Bespoke, every time</span>
        </div>
        <div class="folio mt-14"><span>Where we work</span><i aria-hidden="true"></i></div>
        <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-1 font-serif text-2xl">
          {settings.serviceAreas.map((a) => <li class="flex items-center gap-8 after:h-4 after:w-px after:bg-gold last:after:hidden">{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Dark: the principles, set as a numbered list with a lot of air -->
  <section class="on-dark section bg-moss text-cream" aria-labelledby="highlights-heading">
    <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <div class="folio"><span>Our approach</span><i aria-hidden="true"></i></div>
          <h2 id="highlights-heading" class="h2 mt-8" set:html={emphasis(page.highlightsHeading)} />
        </div>
      </div>
      <dl class="lg:col-span-7 lg:col-start-6">
        {
          page.highlights.map((h, i) => (
            <div class="reveal grid grid-cols-[auto_1fr] gap-x-6 border-t border-gold/30 py-9 first:border-t-0 first:pt-0 md:gap-x-10" style={`--d:${i * 60}ms`}>
              <span class="numeral text-4xl md:text-6xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <dt class="font-serif text-[clamp(1.6rem,1.6vw+1rem,2.4rem)] leading-tight">{h.title}</dt>
                <dd class="mt-3 max-w-md text-cream/80">{h.text}</dd>
              </div>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bg-cream section-tight" aria-labelledby="about-services">
    <div class="wrap">
      <div class="folio"><span id="about-services">What we offer</span><i aria-hidden="true"></i></div>
      <ul class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <li class="border-b border-line">
              <a href={`/services/${s.id}/`} class="flex min-h-16 items-center justify-between py-3 font-serif text-xl no-underline hover:text-gold-deep">{s.data.title}<span aria-hidden="true" class="text-gold-deep">&rarr;</span></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand heading={page.ctaHeading} text={page.ctaText} source="about page" />
</BaseLayout>
