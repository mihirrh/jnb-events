---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Img from '../components/Img.astro';
import CtaBand from '../components/CtaBand.astro';
import Motif from '../components/Motif.astro';
import { getAbout, getServices, getSettings } from '../lib/content';
import { breadcrumbs, faqPage, aboutPage } from '../lib/schema';
import { emphasis } from '../lib/text';

const page = await getAbout();
const services = await getServices();
const settings = await getSettings();
const site = Astro.site!.toString();
---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={page.image}
  imageAlt={page.imageAlt}
  jsonLd={[
    aboutPage({ siteUrl: site, name: page.seo.title, description: page.seo.description }),
    faqPage(page.faq),
    breadcrumbs([{ name: 'Home', url: site }, { name: 'About', url: `${site}about/` }]),
  ]}
>
  <PageHero folio="04" eyebrow={page.eyebrow} heading={page.heading} lead={page.lead} />

  <!-- Portrait photograph at the left; text and a smaller inset image breaking out of the column at the right -->
  <section class="bg-cream pb-[clamp(5rem,10vw,10rem)]">
    <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="relative lg:col-span-6">
        <Img src={page.image} alt={page.imageAlt} ratio={3 / 4} sizes="(min-width:1024px) 46vw, 94vw" class="parallax" reveal />
      </div>
      <div class="lg:col-span-5 lg:col-start-8 lg:pt-32">
        <p class="standfirst reveal">
          Based in {settings.location.locality} and covering {settings.location.region} and the rest of the UK, we deliver premium-quality styling and entertainment at competitive prices.
        </p>
        <div class="relative mt-14 lg:-ml-32">
          <Img src={page.secondImage} alt={page.secondImageAlt} ratio={4 / 3} sizes="(min-width:1024px) 34vw, 94vw" reveal delay={150} />
          <span class="cap">Bespoke, every time</span>
        </div>
        <div class="folio mt-14"><span>Where we work</span><i aria-hidden="true"></i></div>
        <ul class="mt-5 flex flex-wrap gap-x-8 gap-y-1 font-serif text-2xl">
          {settings.serviceAreas.map((a) => <li class="flex items-center gap-8 after:h-4 after:w-px after:bg-gold last:after:hidden">{a}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- Dark: the principles, set as a numbered list with a lot of air -->
  <section class="on-dark section bg-moss text-cream" aria-labelledby="highlights-heading">
    <div class="wrap grid gap-16 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <div class="folio"><span>Our approach</span><i aria-hidden="true"></i></div>
          <h2 id="highlights-heading" class="h2 mt-8" set:html={emphasis(page.highlightsHeading)} />
        </div>
      </div>
      <dl class="lg:col-span-7 lg:col-start-6">
        {
          page.highlights.map((h, i) => (
            <div class="reveal border-t border-gold/30 py-9 pl-[4.25rem] first:border-t-0 first:pt-0 md:pl-[7rem]" style={`--d:${i * 60}ms`}>
              <dt class="relative font-serif text-[clamp(1.6rem,1.6vw+1rem,2.4rem)] leading-tight">
                <span class="numeral absolute -left-[4.25rem] top-0 text-4xl leading-none md:-left-[7rem] md:text-6xl" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                {h.title}
              </dt>
              <dd class="mt-3 max-w-md text-cream/80">{h.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- Transition: moss → cream, softened with a centred motif mark -->
  <div class="relative bg-cream" aria-hidden="true">
    <div class="absolute inset-x-0 top-0 h-16 bg-moss"></div>
    <div class="relative z-10 flex justify-center pt-5 pb-2">
      <Motif variant="botanical" size={46} class="text-gold opacity-50" />
    </div>
  </div>

  <section class="bg-cream section-tight" aria-labelledby="about-services">
    <div class="wrap">
      <div class="folio"><span id="about-services">What we offer</span><i aria-hidden="true"></i></div>
      <ul class="mt-8 grid gap-x-10 sm:grid-cols-2 lg:grid-cols-4">
        {
          services.map((s) => (
            <li class="border-b border-line">
              <a href={`/services/${s.id}/`} class="flex min-h-16 items-center justify-between py-3 font-serif text-xl no-underline hover:text-gold-deep">{s.data.title}<span aria-hidden="true" class="text-gold-deep">&rarr;</span></a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- FAQ: native <details> so it works without JavaScript and every answer is in the HTML for search engines. -->
  <section id="faq" class="section-tight bg-cream-deep" aria-labelledby="faq-heading">
    <div class="wrap grid gap-10 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-4">
        <div class="lg:sticky lg:top-32">
          <div class="folio"><span>FAQ</span><i aria-hidden="true"></i></div>
          <h2 id="faq-heading" class="h2 mt-8" set:html={emphasis(page.faqHeading)} />
        </div>
      </div>
      <div class="lg:col-span-7 lg:col-start-6">
        {
          page.faq.map((item) => (
            <details class="group border-t border-line last:border-b">
              <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-6 py-5 [&::-webkit-details-marker]:hidden">
                <h3 class="font-serif text-[clamp(1.2rem,1vw+1rem,1.55rem)] leading-snug">{item.question}</h3>
                <span aria-hidden="true" class="shrink-0 text-2xl text-gold-deep transition-transform duration-300 group-open:rotate-45">+</span>
              </summary>
              <p class="max-w-prose pb-6 pr-10 text-ink-soft">{item.answer}</p>
            </details>
          ))
        }
        <a href="/terms/" class="link-arrow mt-8">
          <span>Read our full terms</span><span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand heading={page.ctaHeading} text={page.ctaText} source="about page" />
</BaseLayout>
