---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Sprig from '../components/Sprig.astro';
---

<BaseLayout title="Page not found | JNB Events" description="The page you were looking for could not be found. Return to the JNB Events homepage, browse our services or message us on WhatsApp." noindex>
  <section class="relative overflow-hidden bg-cream pt-44 pb-28">
    <Sprig class="pointer-events-none absolute right-6 top-28 hidden h-72 text-gold/45 md:block" />
    <div class="wrap">
      <p class="eyebrow">Error 404</p>
      <h1 class="h1 mt-6 max-w-3xl">We can't find that page.</h1>
      <p class="lead mt-7 max-w-xl">It may have moved. Head back to the homepage, browse our work, or message us directly.</p>
      <div class="mt-10 flex flex-col gap-4 sm:flex-row">
        <a href="/" class="btn btn-ink">Back to home</a>
        <a href="/gallery/" class="btn btn-line">View gallery</a>
        <WhatsAppButton variant="gold" source="404 page" />
      </div>
    </div>
  </section>
</BaseLayout>
