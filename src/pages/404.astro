---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Motif from '../components/Motif.astro';
---

<BaseLayout title="Page not found | JNB Events" description="The page you were looking for could not be found. Return to the JNB Events homepage, browse our services or message us on WhatsApp." noindex>
  <section class="on-dark relative min-h-[88svh] overflow-hidden bg-moss pt-40 pb-24 text-cream">
    <Motif variant="floral" size={84} class="pointer-events-none absolute bottom-16 right-[10%] hidden opacity-70 md:block" />
    <div class="wrap relative">
      <div class="folio"><b>404</b><span>Page not found</span><i aria-hidden="true"></i></div>
      <h1 class="h1 mt-12 max-w-[12ch]">We can't find <em>that page.</em></h1>
      <p class="lead mt-8 max-w-md">It may have moved. Head back to the homepage, browse our work, or message us directly.</p>
      <div class="mt-10 flex flex-col gap-3 sm:flex-row">
        <a href="/" class="btn btn-ink">Back to home</a>
        <a href="/gallery/" class="btn btn-line">View gallery</a>
        <WhatsAppButton variant="line" source="404 page" />
      </div>
    </div>
  </section>
</BaseLayout>
