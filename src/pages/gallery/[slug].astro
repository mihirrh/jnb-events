---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, getSettings, slugify } from '../../lib/content';
import { breadcrumbs, imageGallery } from '../../lib/schema';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      more: projects.filter((p) => p.id !== entry.id && p.data.category === entry.data.category).concat(projects.filter((p) => p.id !== entry.id && p.data.category !== entry.data.category)).slice(0, 3),
    },
  }));
}

const { entry, more } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const settings = await getSettings();
const site = Astro.site!.toString();
const url = `${site}gallery/${entry.id}/`;
const hasBody = Boolean(entry.body?.trim());

const full = await Promise.all(data.images.map((im) => getImage({ src: im.image, width: 2000, format: 'webp', quality: 80 })));
const ldImages = await Promise.all(data.images.slice(0, 6).map(async (im) => new URL((await getImage({ src: im.image, width: 1600, format: 'jpg' })).src, site).toString()));

// Cycle portrait/landscape/square shapes into a varied editorial mosaic, using each photo's own orientation.
const spans = (w: number, h: number) => (w / h > 1.2 ? 'sm:col-span-2' : '');
---

<BaseLayout
  title={`${data.title} | ${settings.siteName} ${settings.location.locality}`}
  description={data.seoDescription ?? data.summary}
  image={data.images[0].image}
  imageAlt={data.images[0].alt}
  jsonLd={[
    imageGallery({ name: data.title, description: data.summary, url, images: ldImages }),
    breadcrumbs([
      { name: 'Home', url: site },
      { name: 'Gallery', url: `${site}gallery/` },
      { name: data.title, url },
    ]),
  ]}
>
  <section class="bg-cream pt-32 md:pt-40">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/gallery/" class="hover:text-ink">Gallery</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`/gallery/category/${slugify(data.category)}/`} class="hover:text-ink">{data.category}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{data.title}</li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-8 lg:grid-cols-12 lg:items-end">
        <div class="lg:col-span-8">
          <p class="eyebrow hero-in">{data.category}</p>
          <h1 class="h1 hero-in mt-6" style="--d:80ms">{data.title}</h1>
        </div>
        <div class="hero-in lg:col-span-4" style="--d:160ms">
          {data.location && <p class="flex items-center gap-2 text-sm text-muted"><Icon name="pin" size={16} class="text-gold-deep" />{data.location}</p>}
          <p class="mt-3 text-[1.02rem] text-ink-soft">{data.summary}</p>
        </div>
      </div>
      <hr class="rule-gold mt-12 max-w-xs" />
    </div>
  </section>

  <section class="section-tight bg-cream" aria-label="Photos">
    <div class="wrap">
      <ul class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:grid-cols-3">
        {
          data.images.map((im, i) => (
            <li class:list={[spans(im.image.width, im.image.height), i === 0 && 'sm:col-span-2 lg:col-span-2']}>
              <button
                type="button"
                class="lightbox-trigger group block w-full cursor-zoom-in text-left"
                data-full={full[i].src}
                data-alt={im.alt}
                aria-label={`View larger: ${im.alt}`}
              >
                <Img
                  src={im.image}
                  alt={im.alt}
                  sizes={i === 0 ? '(min-width:1024px) 66vw, 94vw' : '(min-width:1024px) 33vw, (min-width:640px) 50vw, 94vw'}
                  ratio={i === 0 ? 3 / 2 : im.image.width / im.image.height > 1.2 ? 3 / 2 : 4 / 5}
                  class="media-zoom"
                  priority={i === 0}
                  reveal={i > 0}
                  delay={(i % 3) * 80}
                />
              </button>
            </li>
          ))
        }
      </ul>

      {hasBody && <div class="prose-jnb mt-16 text-[1.05rem] text-ink-soft"><Content /></div>}

      <div class="mt-16 flex flex-col gap-4 border-t border-line pt-10 sm:flex-row sm:items-center sm:justify-between">
        <p class="font-serif text-2xl">Like this style? Tell us about your event.</p>
        <WhatsAppButton label="Ask about this look" message={`Hello JNB Events, I like your "${data.title}" project and would like something similar.`} variant="ink" source={`gallery: ${data.title}`} />
      </div>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="section-tight bg-cream-deep" aria-labelledby="more-projects">
        <div class="wrap">
          <h2 id="more-projects" class="h2">More work</h2>
          <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {more.map((p, i) => <ProjectCard project={p} delay={i * 90} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand eyebrow="Enquire" heading="Let's plan yours." text="Message us on WhatsApp with your date, venue and ideas." source={`gallery: ${data.title}`} />

  <!-- Accessible lightbox using the native <dialog> element -->
  <dialog id="lightbox" class="lightbox" aria-label="Image viewer">
    <form method="dialog" class="lightbox-bar">
      <button type="submit" class="lightbox-close" aria-label="Close image viewer">
        <Icon name="close" size={26} />
      </button>
    </form>
    <img id="lightbox-img" alt="" />
    <p id="lightbox-caption"></p>
  </dialog>
</BaseLayout>

<style is:global>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: rgb(20 17 14 / 0.96); color: var(--color-cream);
  }
  .lightbox[open] { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 3.5rem 1rem 1.5rem; }
  .lightbox::backdrop { background: rgb(20 17 14 / 0.9); }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 8rem); width: auto; height: auto; object-fit: contain; }
  .lightbox-bar { position: absolute; top: 0.5rem; right: 0.5rem; }
  .lightbox-close { width: 3rem; height: 3rem; display: inline-flex; align-items: center; justify-content: center; color: var(--color-cream); background: transparent; border: 0; cursor: pointer; }
  .lightbox-close:focus-visible { outline: 2px solid var(--color-gold-light); }
  #lightbox-caption { font-size: 0.9rem; color: rgb(250 247 242 / 0.8); text-align: center; max-width: 40rem; }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption')!;
  document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.full!;
      img.alt = btn.dataset.alt ?? '';
      caption.textContent = btn.dataset.alt ?? '';
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
  });
  // Click on the dark backdrop closes it; so does Escape (native).
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; img.removeAttribute('src'); });
</script>
