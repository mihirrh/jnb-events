---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Img from '../../components/Img.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import CtaBand from '../../components/CtaBand.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import Icon from '../../components/Icon.astro';
import { getProjects, getSettings, slugify } from '../../lib/content';
import { breadcrumbs, imageGallery } from '../../lib/schema';
import { getImage } from 'astro:assets';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      more: projects.filter((p) => p.id !== entry.id && p.data.category === entry.data.category).concat(projects.filter((p) => p.id !== entry.id && p.data.category !== entry.data.category)).slice(0, 3),
    },
  }));
}

const { entry, more } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const settings = await getSettings();
const site = Astro.site!.toString();
const url = `${site}gallery/${entry.id}/`;
const hasBody = Boolean(entry.body?.trim());

const full_ = await Promise.all(data.images.map((im) => getImage({ src: im.image, width: 2000, format: 'webp', quality: 80 })));
const ldImages = await Promise.all(data.images.slice(0, 6).map(async (im) => new URL((await getImage({ src: im.image, width: 1600, format: 'jpg' })).src, site).toString()));

---

<BaseLayout
  title={`${data.title} | ${settings.siteName} ${settings.location.locality}`}
  description={data.seoDescription ?? data.summary}
  image={data.images[0].image}
  imageAlt={data.images[0].alt}
  jsonLd={[
    imageGallery({ name: data.title, description: data.summary, url, images: ldImages }),
    breadcrumbs([
      { name: 'Home', url: site },
      { name: 'Gallery', url: `${site}gallery/` },
      { name: data.title, url },
    ]),
  ]}
>
  <section class="bg-cream pt-28 md:pt-40">
    <div class="wrap">
      <nav aria-label="Breadcrumb" class="text-xs uppercase tracking-[0.18em] text-muted">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/gallery/" class="hover:text-ink">Gallery</a></li>
          <li aria-hidden="true">/</li>
          <li><a href={`/gallery/category/${slugify(data.category)}/`} class="hover:text-ink">{data.category}</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink">{data.title}</li>
        </ol>
      </nav>

      <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-8">
        <div class="lg:col-span-8">
          <div class="folio hero-in"><span>{data.category}</span><i aria-hidden="true"></i></div>
          <h1 class="h1 hero-in mt-8 !text-[clamp(2.7rem,6.6vw+0.3rem,7rem)]" style="--d:80ms">{data.title}</h1>
        </div>
        <div class="hero-in lg:col-span-3 lg:col-start-10" style="--d:160ms">
          {data.location && <p class="flex items-center gap-2 text-xs uppercase tracking-[0.2em] text-muted"><Icon name="pin" size={16} class="text-gold-deep" />{data.location}</p>}
          <p class="mt-4 text-[1.02rem] text-ink-soft">{data.summary}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Photographs: the first is a full-width plate; the rest alternate between wide and tall so the page
       reads as a spread, not a grid. Every image still opens in the lightbox. -->
  <section class="bg-cream pb-[clamp(4rem,9vw,9rem)] pt-12 md:pt-20" aria-label="Photos">
    <div class="wrap">
      <ul class="grid gap-4 sm:grid-cols-2 sm:gap-6 lg:gap-8">
        {
          data.images.map((im, i) => {
            const rest = data.images.length - 1;
            // First photo and (when the rest is odd) the last one run full width; the others sit two-up.
            const full = i === 0 || (rest % 2 === 1 && i === data.images.length - 1);
            return (
              <li class:list={[full && 'sm:col-span-2']}>
                <button
                  type="button"
                  class="lightbox-trigger group block w-full cursor-zoom-in text-left"
                  data-full={full_[i].src}
                  data-alt={im.alt}
                  aria-label={`View larger: ${im.alt}`}
                >
                  <Img
                    src={im.image}
                    alt={im.alt}
                    sizes={full ? '(min-width:1280px) 1180px, 94vw' : '(min-width:1280px) 580px, (min-width:640px) 47vw, 94vw'}
                    ratio={i === 0 ? 16 / 9 : full ? 16 / 9 : 4 / 3}
                    widths={full ? [640, 1100, 1600, 2000] : [480, 800, 1100]}
                    class="media-zoom"
                    priority={i === 0}
                    reveal={i > 0}
                    delay={(i % 2) * 100}
                  />
                </button>
                <p class="mt-3 font-serif text-base italic text-gold-deep" aria-hidden="true">{String(i + 1).padStart(2, '0')} <span class="text-muted">/ {String(data.images.length).padStart(2, '0')}</span></p>
              </li>
            );
          })
        }
      </ul>

      {hasBody && <div class="prose-jnb mt-16 text-[1.08rem] text-ink-soft lg:ml-[calc(100%/12*4)]"><Content /></div>}

      <div class="mt-20 grid items-end gap-8 border-t border-line pt-10 lg:grid-cols-12">
        <p class="font-serif text-[clamp(1.8rem,2.4vw+1rem,3rem)] leading-tight lg:col-span-8">Like this style? <em>Tell us about your event.</em></p>
        <div class="lg:col-span-4 lg:text-right">
          <WhatsAppButton label="Ask about this look" message={`Hello JNB Events, I like your "${data.title}" project and would like something similar.`} variant="ink" source={`gallery: ${data.title}`} class="w-full sm:w-auto" />
        </div>
      </div>
    </div>
  </section>

  {
    more.length > 0 && (
      <section class="section bg-cream-deep" aria-labelledby="more-projects">
        <div class="wrap">
          <h2 id="more-projects" class="h2">More <em>work</em></h2>
          <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {more.map((p, i) => <ProjectCard project={p} index={i} ratio={4 / 5} delay={i * 90} />)}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand eyebrow="Enquire" heading="Let's plan *yours.*" text="Message us on WhatsApp with your date, venue and ideas." source={`gallery: ${data.title}`} />

  <!-- Accessible lightbox using the native <dialog> element -->
  <dialog id="lightbox" class="lightbox" aria-label="Image viewer">
    <form method="dialog" class="lightbox-bar">
      <button type="submit" class="lightbox-close" aria-label="Close image viewer">
        <Icon name="close" size={26} />
      </button>
    </form>
    <img id="lightbox-img" alt="" />
    <p id="lightbox-caption"></p>
  </dialog>
</BaseLayout>

<style is:global>
  .lightbox {
    width: 100vw; height: 100dvh; max-width: none; max-height: none; margin: 0; padding: 0;
    border: 0; background: rgb(20 17 14 / 0.97); color: var(--color-cream);
  }
  .lightbox[open] { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 1rem; padding: 3.5rem 1rem 1.5rem; }
  .lightbox::backdrop { background: rgb(20 17 14 / 0.9); }
  .lightbox img { max-width: 100%; max-height: calc(100dvh - 8rem); width: auto; height: auto; object-fit: contain; }
  .lightbox-bar { position: absolute; top: 0.5rem; right: 0.5rem; }
  .lightbox-close { width: 3rem; height: 3rem; display: inline-flex; align-items: center; justify-content: center; color: var(--color-cream); background: transparent; border: 0; cursor: pointer; }
  .lightbox-close:focus-visible { outline: 2px solid var(--color-gold-light); }
  #lightbox-caption { font-size: 0.9rem; color: rgb(250 247 242 / 0.8); text-align: center; max-width: 40rem; }
</style>

<script>
  const dialog = document.getElementById('lightbox') as HTMLDialogElement;
  const img = document.getElementById('lightbox-img') as HTMLImageElement;
  const caption = document.getElementById('lightbox-caption')!;
  document.querySelectorAll<HTMLButtonElement>('.lightbox-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      img.src = btn.dataset.full!;
      img.alt = btn.dataset.alt ?? '';
      caption.textContent = btn.dataset.alt ?? '';
      dialog.showModal();
      document.documentElement.style.overflow = 'hidden';
    });
  });
  // Click on the dark backdrop closes it; so does Escape (native).
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { document.documentElement.style.overflow = ''; img.removeAttribute('src'); });
</script>
