---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import GalleryFilter from '../../components/GalleryFilter.astro';
import CtaBand from '../../components/CtaBand.astro';
import { getSimplePage, getProjects, categoriesInUse } from '../../lib/content';
import { breadcrumbs } from '../../lib/schema';
import { plate } from '../../lib/plates';

const { data: page } = await getSimplePage('gallery');
const projects = await getProjects();
const cats = categoriesInUse(projects);
const site = Astro.site!.toString();

---

<BaseLayout
  title={page.seo.title}
  description={page.seo.description}
  image={projects[0]?.data.images[0].image}
  imageAlt={projects[0]?.data.images[0].alt}
  jsonLd={[breadcrumbs([{ name: 'Home', url: site }, { name: 'Gallery', url: `${site}gallery/` }])]}
>
  <PageHero folio="03" eyebrow={page.eyebrow} heading={page.heading} lead={page.lead} />

  <section class="bg-cream pb-[clamp(4rem,9vw,9rem)]" aria-label="Projects">
    <div class="wrap">
      <GalleryFilter available={cats} />
      <p class="mt-5 text-xs uppercase tracking-[0.2em] text-muted" aria-live="polite">{projects.length} {projects.length === 1 ? 'project' : 'projects'}</p>

      <div class="mt-14 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:mt-20 lg:grid-cols-12 lg:gap-y-0">
        {
          projects.map((p, i) => {
            const pl = plate(i);
            return <ProjectCard project={p} index={i} ratio={pl.ratio} class={pl.cls} delay={(i % 2) * 120} sizes="(min-width:1024px) 52vw, (min-width:640px) 48vw, 94vw" />;
          })
        }
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Like what you see?"
    heading="Let's create *yours.*"
    text="Message us on WhatsApp with your date and venue and we will talk through ideas."
    source="gallery page"
  />
</BaseLayout>
