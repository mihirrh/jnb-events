---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/PageHero.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import GalleryFilter from '../../../components/GalleryFilter.astro';
import CtaBand from '../../../components/CtaBand.astro';
import { getProjects, categoriesInUse, slugify, getSettings } from '../../../lib/content';
import { breadcrumbs } from '../../../lib/schema';
import { plate } from '../../../lib/plates';

export async function getStaticPaths() {
  const projects = await getProjects();
  const cats = categoriesInUse(projects);
  return cats.map((category) => ({
    params: { category: slugify(category) },
    props: { category, all: cats, projects: projects.filter((p) => p.data.category === category) },
  }));
}

const { category, all, projects } = Astro.props;
const settings = await getSettings();
const site = Astro.site!.toString();
const url = `${site}gallery/category/${slugify(category)}/`;
---

<BaseLayout
  title={`${category} Gallery | ${settings.siteName} ${settings.location.locality}`}
  description={`Browse ${category.toLowerCase()} projects by ${settings.siteName} in ${settings.location.locality}, ${settings.location.region} and across the UK.`}
  image={projects[0].data.images[0].image}
  imageAlt={projects[0].data.images[0].alt}
  jsonLd={[
    breadcrumbs([
      { name: 'Home', url: site },
      { name: 'Gallery', url: `${site}gallery/` },
      { name: category, url },
    ]),
  ]}
>
  <PageHero folio="03" eyebrow="Gallery" heading={category} lead={`${projects.length} ${projects.length === 1 ? 'project' : 'projects'} in this category.`} />

  <section class="bg-cream pb-[clamp(4rem,9vw,9rem)]" aria-label={`${category} projects`}>
    <div class="wrap">
      <h2 class="sr-only">{category} projects</h2>
      <GalleryFilter active={category} available={all} />
      <div class="mt-14 grid gap-x-8 gap-y-16 sm:grid-cols-2 lg:mt-20 lg:grid-cols-12 lg:gap-y-0">
        {projects.map((p, i) => {
          const pl = plate(i);
          return <ProjectCard project={p} index={i} ratio={pl.ratio} class={pl.cls} delay={(i % 2) * 120} sizes="(min-width:1024px) 52vw, (min-width:640px) 48vw, 94vw" />;
        })}
      </div>
    </div>
  </section>

  <CtaBand
    eyebrow="Enquire"
    heading="Want something *similar?*"
    text="Message us on WhatsApp and tell us about your event."
    source={`${category} gallery`}
  />
</BaseLayout>
