---
/**
 * MandapExplorer.astro
 * Signature Mandap Architectural Collection Browser.
 *
 * An interactive, tabbed architectural showcase allowing couples and planners to:
 * - Explore signature mandap architectural styles with smooth crossfading photography.
 * - Dynamically pull case-study details from gallery/category/mandaps-and-stages/ (the projects collection).
 * - Pull and highlight standard ceremonial inclusions from /services/mandaps-and-stages/ ("What's Included in Your Mandap Setup").
 * - Fully customize styles, staging specs, and copy via PagesCMS (src/content/pages/home.yaml).
 * - Enquire instantly via WhatsApp with pre-filled bespoke messages.
 *
 * Technical:
 * - Pure CSS transitions + lightweight vanilla JavaScript.
 * - 0 external animation libraries (100% compliant with static audit rules).
 * - Fully accessible ARIA tablist/tabpanel with keyboard navigation.
 * - Inlined client script (<script is:inline>).
 */
import Img from './Img.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import Motif from './Motif.astro';
import { emphasis, plain } from '../lib/text';
import { getProjects } from '../lib/content';
import type { ImageMetadata } from 'astro';

import fallbackCarvedImg from '../assets/media/gallery/marquee_carved_wooden_mandap.jpg';
import fallbackGoldImg from '../assets/media/gallery/modern_gold_mandap_blush_florals.jpg';
import fallbackArchwayImg from '../assets/media/gallery/historic_archway_mandap_setup.jpg';
import fallbackGrandImg from '../assets/media/gallery/grand_mandap_modern_venue.jpg';

interface CmsMandapItem {
  id: string;
  projectSlug?: string;
  title: string;
  subtitle: string;
  image?: ImageMetadata;
  imageAlt?: string;
  description?: string;
  designHighlights: string;
  ceremonyInclusions: string;
  lightingProduction: string;
  whatsappMessage?: string;
}

interface MandapData {
  eyebrow?: string;
  heading?: string;
  intro?: string;
  inclusionsHeading?: string;
  inclusionsSummary?: string;
  serviceLinkText?: string;
  galleryLinkText?: string;
  items?: CmsMandapItem[];
}

interface Props {
  class?: string;
  folioNumber?: string;
  data?: MandapData;
}

const { class: className = '', folioNumber = '03', data } = Astro.props;

// 1. Fetch dynamic data from the Mandaps & Stages gallery category
const allProjects = await getProjects();
const mandapProjects = allProjects.filter((p) => p.data.category === 'Mandaps & Stages');
const projectsBySlug = new Map(mandapProjects.map((p) => [p.id, p]));

// Standard inclusions extracted from /services/mandaps-and-stages/
const standardInclusions = [
  { item: '4 × Choris', desc: 'Carved ceremonial pillars for mandap entrance' },
  { item: '2 × Bajots & Patlas', desc: 'Low ceremonial wooden tables & stools' },
  { item: '6 × Ornate Chairs', desc: 'Bridal couple, parent & family seating' },
  { item: '1 × Sacred Havan Kund', desc: 'Copper ceremonial fire pit for rituals' },
  { item: 'Ganesh for Foyer', desc: 'Ornate statue & welcome display at entrance' },
  { item: 'Entrance Gate / Arch', desc: 'Decorative ceremony entrance archway' },
  { item: 'Pleated Backdrop', desc: 'Draped pleated fabric framing the stage' },
  { item: 'Carpet for Stage & Aisle', desc: 'Pristine runner for mandap and walkway' },
];

// Fallback items if none are provided
const fallbackCmsItems: CmsMandapItem[] = [
  {
    id: 'traditional-carved-wooden-mandap',
    projectSlug: 'traditional-carved-wooden-mandap',
    title: 'The Royal Carved Mandap',
    subtitle: 'Traditional Artisanship & Sacred Warmth',
    image: fallbackCarvedImg,
    imageAlt: 'Traditional hand-carved wooden Hindu wedding mandap with red and orange floral canopy in Leicestershire marquee',
    description:
      'Intricately carved wooden pillars and ornamental arches crowned with a rich canopy of fresh crimson, amber, and ivory florals. Complete with matching carved bridal thrones and sacred havan kund.',
    designHighlights: 'Solid hand-carved teak pillars, ornamental domed arches, multi-tier floral canopy headers, custom carved entrance toran.',
    ceremonyInclusions: '4 Choris, 2 Bajots, 2 Patlas, 6 Carved Bridal Chairs, Sacred Copper Havan Kund, Red/Ivory Aisle Runner.',
    lightingProduction: 'Warm amber base uplighting, dedicated havan smoke ventilation setup, pin-spotting on bridal seating.',
    whatsappMessage: 'Hello JNB Events, I am interested in checking availability for your Royal Carved Wooden Mandap setup.',
  },
  {
    id: 'modern-gold-geometric-mandap',
    projectSlug: 'modern-gold-geometric-mandap',
    title: 'Modern Gold Geometric',
    subtitle: 'Contemporary Glamour & Open-Frame Elegance',
    image: fallbackGoldImg,
    imageAlt: 'Luxury modern gold geometric wedding mandap with mirrored gold aisle runner and blush florals in Leicester hall',
    description:
      'Sleek, architectural metallic gold frames paired with lavish blush, plum, and cream floral runners. Accompanied by our radiant gold aisle runner and soft ambient spotlighting.',
    designHighlights: 'High-polish reflective gold framing, open-concept geometric pillars, asymmetric luxury blush & ivory floral headers.',
    ceremonyInclusions: 'Minimalist luxury bridal thrones, matching gold ceremonial stools (Choris & Bajots), mirrored gold aisle runner.',
    lightingProduction: 'DMX-controlled perimeter wash lights, overhead warm pin-spots, mirrored aisle under-glow reflection.',
    whatsappMessage: 'Hello JNB Events, I am interested in checking availability for your Modern Gold Geometric Mandap setup.',
  },
  {
    id: 'archway-mandap',
    projectSlug: 'archway-mandap',
    title: 'Historic Archway & Brick',
    subtitle: 'Heritage Character Meets Romantic Festoons',
    image: fallbackArchwayImg,
    imageAlt: 'Grand luxury mandap setup inside a historic brick archway venue with lime wash Chiavari chairs and festoon lights',
    description:
      'A breathtaking juxtaposition of rustic heritage brickwork with delicate cascading floral garlands, warm overhead festoon canopies, and pristine lime wash Chiavari ceremony seating.',
    designHighlights: 'Architectural integration with exposed heritage brickwork, cascading organic eucalyptus & ivory rose garlands, bespoke floral arches.',
    ceremonyInclusions: 'Lime wash Chiavari guest seating, carved Ganesh foyer sentinels, ceremonial bajot suite, natural woven aisle runner.',
    lightingProduction: 'Suspended warm filament festoon canopy, warm architectural stone uplighters, soft foreground ceremony glow.',
    whatsappMessage: 'Hello JNB Events, I am interested in checking availability for your Historic Archway Mandap setup.',
  },
  {
    id: 'modern-gold-aisle-mandap',
    projectSlug: 'modern-gold-aisle-mandap',
    title: 'Grand Symmetrical Floral',
    subtitle: 'Monumental Scale & Mirrored Runway',
    image: fallbackGrandImg,
    imageAlt: 'Grand luxury Asian wedding ceremony setup with symmetrical white seating, gold aisle, and carved Ganesh pillars in UK venue',
    description:
      'Engineered for high-capacity luxury celebrations. Features grand floral canopy pillars, carved Ganesh walkway sentinels, full room mood lighting, and flawless symmetrical seating layout.',
    designHighlights: 'Monumental 6-pillar grand structure, 360-degree dense floral crown, dual elevated carved Ganesh sentinel columns at aisle threshold.',
    ceremonyInclusions: 'Complete 8-piece royal throne ensemble, ceremonial havan enclosure, symmetrical auditorium ceremony seating, mirrored gold central runway.',
    lightingProduction: 'Full-venue computerized intelligent lighting, synchronized aisle entrance spotlights, atmospheric haze dispersion.',
    whatsappMessage: 'Hello JNB Events, I am interested in checking availability for your Grand Symmetrical Floral Mandap setup.',
  },
];

// Determine active CMS items or generate from gallery projects
const rawItems: CmsMandapItem[] =
  data?.items && data.items.length > 0
    ? data.items
    : fallbackCmsItems;

// Hydrate items with dynamic gallery project data
const styles = rawItems.map((item) => {
  const matchedProject = item.projectSlug
    ? projectsBySlug.get(item.projectSlug)
    : projectsBySlug.get(item.id);

  const image = item.image ?? matchedProject?.data.images[0]?.image ?? fallbackCarvedImg;
  const imageAlt =
    item.imageAlt ||
    matchedProject?.data.images[0]?.alt ||
    `${item.title} wedding mandap ceremony setup by JNB Events`;
  const description = item.description || matchedProject?.data.summary || '';
  const galleryUrl = matchedProject ? `/gallery/${matchedProject.id}/` : undefined;
  const photoCount = matchedProject?.data.images.length ?? 0;

  return {
    ...item,
    image,
    imageAlt,
    description,
    galleryUrl,
    photoCount,
    projectSlug: matchedProject?.id || item.projectSlug,
  };
});

const eyebrow = data?.eyebrow ?? 'Signature Staging Collection';
const heading = data?.heading ?? 'Explore the *artistry of our mandaps*';
const intro =
  data?.intro ??
  "Every mandap is crafted as a bespoke ceremonial stage, tailored to your venue's architecture and your cultural heritage.";
const inclusionsHeading =
  data?.inclusionsHeading ?? "What's Included in Your Mandap Setup";
const inclusionsSummary =
  data?.inclusionsSummary ??
  'Every full ceremony mandap package is comprehensively equipped with all essential ceremonial and aesthetic elements:';
const serviceLinkText =
  data?.serviceLinkText ?? 'View Full Mandap Service & Staging Inclusions';
const galleryLinkText =
  data?.galleryLinkText ?? 'Browse Mandaps & Stages in Gallery';
---

<section
  class:list={['section on-dark relative overflow-hidden bg-night text-cream', className]}
  aria-labelledby="mandap-explorer-heading"
  data-mandap-explorer
>
  <!-- Background subtle ambient glow -->
  <div class="pointer-events-none absolute -right-36 top-1/4 h-[35rem] w-[35rem] rounded-full bg-gold/10 blur-[120px]" aria-hidden="true"></div>
  <div class="pointer-events-none absolute -left-36 bottom-10 h-[30rem] w-[30rem] rounded-full bg-gold/5 blur-[100px]" aria-hidden="true"></div>

  <div class="wrap relative z-10">
    <!-- Folio & Section Eyebrow -->
    <div class="folio">
      <b>{folioNumber}</b>
      <span id="mandap-explorer-heading">{eyebrow}</span>
      <i aria-hidden="true"></i>
    </div>

    <!-- Section Header -->
    <div class="mt-8 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow">{eyebrow}</p>
        <h2 class="h2 reveal mt-3 max-w-[18ch]" aria-label={plain(heading)} set:html={emphasis(heading)} />
      </div>
      <div class="max-w-md">
        <p class="lead !text-cream/80">
          {intro}
        </p>
        <div class="mt-4 flex flex-wrap gap-4 text-xs tracking-wider uppercase font-sans">
          <a
            href="/services/mandaps-and-stages/"
            class="text-gold-light hover:underline inline-flex items-center gap-1.5 font-medium transition-colors"
          >
            <span>Service Details</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
          <a
            href="/gallery/category/mandaps-and-stages/"
            class="text-cream/70 hover:text-gold-light hover:underline inline-flex items-center gap-1.5 transition-colors"
          >
            <span>{galleryLinkText}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Style Selector Tabs -->
    <div
      class="mt-12 flex flex-wrap gap-2 border-b border-cream/15 pb-4 sm:gap-4"
      role="tablist"
      aria-label="Mandap Design Styles"
    >
      {
        styles.map((style, idx) => (
          <button
            type="button"
            role="tab"
            aria-selected={idx === 0 ? 'true' : 'false'}
            aria-controls={`panel-${style.id}`}
            id={`tab-${style.id}`}
            data-mandap-tab={style.id}
            tabindex={idx === 0 ? 0 : -1}
            class:list={[
              'tab-btn group relative px-3 py-2.5 text-left font-serif text-base tracking-tight transition-all duration-300 sm:px-4 sm:py-3 sm:text-lg md:text-xl',
              idx === 0 ? 'is-active text-gold-light' : 'text-cream/60 hover:text-cream',
            ]}
          >
            <span class="mr-2 font-sans text-xs font-semibold tracking-widest text-gold-light/60 transition-colors group-hover:text-gold-light">
              0{idx + 1}
            </span>
            <span>{style.title}</span>
            <span
              class:list={[
                'tab-indicator absolute bottom-[-17px] left-0 right-0 h-[2px] bg-gold-light transition-all duration-300',
                idx === 0 ? 'opacity-100 scale-x-100' : 'opacity-0 scale-x-0',
              ]}
              aria-hidden="true"
            />
          </button>
        ))
      }
    </div>

    <!-- Interactive Panels Grid -->
    <div class="mt-10 grid gap-10 lg:grid-cols-12 lg:gap-14 lg:items-start">
      <!-- Left: Interactive Image Showcase -->
      <div class="relative overflow-hidden rounded-sm lg:col-span-7">
        <div class="relative aspect-[4/3] w-full overflow-hidden bg-night/80 shadow-2xl sm:aspect-[16/10]">
          {
            styles.map((style, idx) => (
              <div
                id={`panel-img-${style.id}`}
                class:list={[
                  'explorer-img-panel absolute inset-0 transition-all duration-700 ease-out',
                  idx === 0 ? 'opacity-100 scale-100 z-10' : 'opacity-0 scale-105 z-0 pointer-events-none',
                ]}
              >
                <Img
                  src={style.image}
                  alt={style.imageAlt}
                  sizes="(min-width:1024px) 58vw, 95vw"
                  class="h-full w-full object-cover transition-transform duration-1000 ease-out hover:scale-105"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-night/90 via-night/25 to-transparent" aria-hidden="true" />

                <!-- Bottom Image Badges & Gallery Link -->
                <div class="absolute bottom-4 left-4 right-4 flex items-center justify-between gap-3">
                  <span class="rounded bg-night/80 px-3 py-1 font-sans text-xs tracking-widest uppercase text-gold-light backdrop-blur-md">
                    {style.subtitle}
                  </span>
                  {style.galleryUrl ? (
                    <a
                      href={style.galleryUrl}
                      class="inline-flex items-center gap-1.5 rounded bg-night/90 px-3 py-1 font-sans text-xs font-medium tracking-wider text-cream/90 hover:text-gold-light backdrop-blur-md transition-colors"
                      title={`View full photo gallery for ${style.title}`}
                    >
                      <span>Gallery Case Study ({style.photoCount} Photos)</span>
                      <span aria-hidden="true">&rarr;</span>
                    </a>
                  ) : (
                    <Motif variant="floral" size={28} class="text-gold-light/60" />
                  )}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- Right: Detailed Specifications & WhatsApp CTA -->
      <div class="relative lg:col-span-5 min-h-[460px]">
        {
          styles.map((style, idx) => (
            <div
              id={`panel-${style.id}`}
              role="tabpanel"
              aria-labelledby={`tab-${style.id}`}
              class:list={[
                'explorer-content-panel space-y-6 transition-all duration-500 ease-out',
                idx === 0 ? 'is-active opacity-100 translate-y-0 relative' : 'hidden opacity-0 translate-y-4 absolute inset-x-0 top-0',
              ]}
            >
              <div>
                <p class="font-sans text-xs font-semibold tracking-widest uppercase text-gold-light">
                  {style.subtitle}
                </p>
                <h3 class="h2 mt-2 text-cream">{style.title}</h3>
              </div>

              <p class="text-[1.02rem] leading-relaxed text-cream/90">{style.description}</p>

              <!-- 3-Tier Luxury Staging Specs -->
              <div class="space-y-4 rounded border border-cream/15 bg-cream/5 p-5 backdrop-blur-sm">
                <div>
                  <h4 class="font-sans text-xs font-semibold tracking-widest uppercase text-gold-light">
                    Architectural Highlights
                  </h4>
                  <p class="mt-1 text-sm text-cream/90">{style.designHighlights}</p>
                </div>
                <hr class="border-cream/10" />
                <div>
                  <h4 class="font-sans text-xs font-semibold tracking-widest uppercase text-gold-light">
                    Ceremony Inclusions
                  </h4>
                  <p class="mt-1 text-sm text-cream/90">{style.ceremonyInclusions}</p>
                </div>
                <hr class="border-cream/10" />
                <div>
                  <h4 class="font-sans text-xs font-semibold tracking-widest uppercase text-gold-light">
                    Lighting & Production
                  </h4>
                  <p class="mt-1 text-sm text-cream/80">{style.lightingProduction}</p>
                </div>
              </div>

              <!-- Action Links: WhatsApp + Gallery Project Link -->
              <div class="pt-2 flex flex-col sm:flex-row gap-3 sm:items-center">
                <WhatsAppButton
                  label={`Enquire for ${style.title}`}
                  message={style.whatsappMessage ?? `Hello JNB Events, I am interested in checking availability for your ${style.title} setup.`}
                  variant="ink"
                  source={`mandap explorer - ${style.id}`}
                  class="w-full sm:w-auto"
                />
                {style.galleryUrl && (
                  <a
                    href={style.galleryUrl}
                    class="btn-ghost inline-flex items-center justify-center gap-2 px-5 py-3 text-center text-sm font-sans tracking-wide text-cream/80 hover:text-gold-light hover:border-gold-light transition-colors"
                  >
                    <span>View Case Study</span>
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>

    <!-- =========================================================================
         WHAT'S INCLUDED IN YOUR MANDAP SETUP (Service Integration Banner)
         Pulled and referenced directly from /services/mandaps-and-stages/
         ========================================================================= -->
    <div class="mt-16 rounded border border-gold/30 bg-night/90 p-6 md:p-8 backdrop-blur-md relative overflow-hidden">
      <div class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-gold/10 blur-[80px]" aria-hidden="true"></div>

      <div class="relative z-10 flex flex-col justify-between gap-6 lg:flex-row lg:items-center">
        <div>
          <p class="font-sans text-xs font-semibold tracking-widest uppercase text-gold-light">
            Essential Ceremony Specifications
          </p>
          <h3 class="font-serif text-2xl md:text-3xl text-cream mt-1">
            {inclusionsHeading}
          </h3>
          <p class="mt-2 max-w-2xl text-sm md:text-base text-cream/80 leading-relaxed">
            {inclusionsSummary}
          </p>
        </div>

        <div class="flex flex-wrap gap-4 shrink-0">
          <a
            href="/services/mandaps-and-stages/"
            class="inline-flex items-center gap-2 rounded bg-gold/20 hover:bg-gold/30 text-gold-light px-5 py-3 text-xs md:text-sm font-sans font-medium tracking-wide uppercase transition-colors"
          >
            <span>{serviceLinkText}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Inclusions 8-item grid -->
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 border-t border-cream/10 pt-6">
        {
          standardInclusions.map((inc) => (
            <div class="rounded bg-cream/5 p-3.5 border border-cream/10 flex flex-col justify-between">
              <span class="font-sans text-xs font-semibold text-gold-light tracking-wide">
                {inc.item}
              </span>
              <span class="mt-1 text-xs text-cream/70 leading-normal">
                {inc.desc}
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    function initMandapExplorer() {
      const explorers = document.querySelectorAll('[data-mandap-explorer]');
      if (!explorers.length) return;

      explorers.forEach(function (explorer) {
        if (explorer.dataset.initialized === 'true') return;
        explorer.dataset.initialized = 'true';

        const tabs = Array.from(explorer.querySelectorAll('[data-mandap-tab]'));
        const imgPanels = Array.from(explorer.querySelectorAll('.explorer-img-panel'));
        const contentPanels = Array.from(explorer.querySelectorAll('.explorer-content-panel'));

        function activateTab(tab) {
          const targetId = tab.getAttribute('data-mandap-tab');
          if (!targetId) return;

          // 1. Update Tab button states
          tabs.forEach(function (t) {
            const isSelected = t === tab;
            t.setAttribute('aria-selected', isSelected ? 'true' : 'false');
            t.setAttribute('tabindex', isSelected ? '0' : '-1');

            const indicator = t.querySelector('.tab-indicator');
            if (isSelected) {
              t.classList.remove('text-cream/60');
              t.classList.add('is-active', 'text-gold-light');
              if (indicator) {
                indicator.classList.remove('opacity-0', 'scale-x-0');
                indicator.classList.add('opacity-100', 'scale-x-100');
              }
            } else {
              t.classList.remove('is-active', 'text-gold-light');
              t.classList.add('text-cream/60');
              if (indicator) {
                indicator.classList.remove('opacity-100', 'scale-x-100');
                indicator.classList.add('opacity-0', 'scale-x-0');
              }
            }
          });

          // 2. Crossfade Image Panels
          imgPanels.forEach(function (img) {
            if (img.id === 'panel-img-' + targetId) {
              img.classList.remove('opacity-0', 'scale-105', 'pointer-events-none', 'z-0');
              img.classList.add('opacity-100', 'scale-100', 'z-10');
            } else {
              img.classList.remove('opacity-100', 'scale-100', 'z-10');
              img.classList.add('opacity-0', 'scale-105', 'pointer-events-none', 'z-0');
            }
          });

          // 3. Transition Content Panels
          contentPanels.forEach(function (content) {
            if (content.id === 'panel-' + targetId) {
              content.classList.remove('hidden', 'opacity-0', 'translate-y-4', 'absolute');
              content.classList.add('is-active', 'opacity-100', 'translate-y-0', 'relative');
            } else {
              content.classList.remove('is-active', 'opacity-100', 'translate-y-0', 'relative');
              content.classList.add('hidden', 'opacity-0', 'translate-y-4', 'absolute');
            }
          });
        }

        // Click handler
        tabs.forEach(function (tab) {
          tab.addEventListener('click', function () {
            activateTab(tab);
          });
        });

        // Keyboard navigation (Left / Right / Home / End)
        explorer.addEventListener('keydown', function (e) {
          if (e.target && e.target.hasAttribute('data-mandap-tab')) {
            const currentIdx = tabs.indexOf(e.target);
            let nextIdx = -1;

            if (e.key === 'ArrowRight' || e.key === 'ArrowDown') {
              nextIdx = (currentIdx + 1) % tabs.length;
            } else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') {
              nextIdx = (currentIdx - 1 + tabs.length) % tabs.length;
            } else if (e.key === 'Home') {
              nextIdx = 0;
            } else if (e.key === 'End') {
              nextIdx = tabs.length - 1;
            }

            if (nextIdx !== -1) {
              e.preventDefault();
              const nextTab = tabs[nextIdx];
              nextTab.focus();
              activateTab(nextTab);
            }
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMandapExplorer);
    } else {
      initMandapExplorer();
    }
    document.addEventListener('astro:page-load', initMandapExplorer);
  })();
</script>
