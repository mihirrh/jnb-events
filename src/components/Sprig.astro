---
/** Restrained botanical motif inspired by the JNB logo. Decorative only. */
interface Props { class?: string; flip?: boolean }
const { class: className, flip = false } = Astro.props;
---

<svg
  class={className}
  style={flip ? 'transform:scaleX(-1)' : undefined}
  viewBox="0 0 120 220"
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M60 218C58 170 62 120 66 70c2-26 6-46 12-62"></path>
  <path d="M62 190c-18-6-32-22-36-42 18 4 32 20 36 42Z"></path>
  <path d="M64 150c16-4 30-18 36-36-16 2-30 14-36 36Z"></path>
  <path d="M63 118c-16-6-28-20-30-38 16 4 28 18 30 38Z"></path>
  <path d="M67 84c14-4 26-16 30-32-14 2-26 12-30 32Z"></path>
  <path d="M70 52c-10-6-18-16-18-30 12 4 18 14 18 30Z"></path>
  <circle cx="78" cy="8" r="3"></circle>
</svg>
