---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

/**
 * Optimised responsive image.
 * - Generates AVIF + WebP + JPEG at several widths and a matching `sizes` hint.
 * - `ratio` crops at build time (width / height) so phones never download the wrong shape.
 * - Lazy-loaded by default; pass `priority` for the one above-the-fold LCP image.
 */
interface Props {
  src: ImageMetadata;
  alt: string;
  /** CSS `sizes` hint, e.g. "(min-width:1024px) 50vw, 100vw". */
  sizes: string;
  /** width / height, e.g. 4/5. Omit to keep the photo's own shape. */
  ratio?: number;
  widths?: number[];
  priority?: boolean;
  class?: string;
  /** CSS object-position for the crop, e.g. "50% 30%". */
  position?: string;
  reveal?: boolean;
  delay?: number;
}

const {
  src,
  alt,
  sizes,
  ratio,
  widths = [400, 640, 900, 1280, 1800],
  priority = false,
  class: className = '',
  position,
  reveal = false,
  delay = 0,
} = Astro.props;

const usable = widths.filter((w) => w <= src.width);
const finalWidths = usable.length ? usable : [src.width];
const baseW = finalWidths[finalWidths.length - 1];
const crop = ratio ? { width: baseW, height: Math.round(baseW / ratio) } : {};
const aspect = ratio ?? src.width / src.height;
---

<div
  class:list={['media', reveal && 'reveal-img', className]}
  style={`aspect-ratio:${aspect.toFixed(4)};${delay ? `--d:${delay}ms;` : ''}`}
>
  <Picture
    src={src}
    alt={alt}
    widths={finalWidths}
    sizes={sizes}
    formats={['avif', 'webp']}
    fallbackFormat="jpg"
    quality={72}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
    style={position ? `object-position:${position}` : undefined}
    {...crop}
  />
</div>
