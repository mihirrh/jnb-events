---
import { getSettings } from '../lib/content';
import { whatsappUrl } from '../lib/contact';
import { NAV, isActive } from '../lib/nav';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

/**
 * Fixed header. On pages with a full-bleed hero (`overlay`) it starts transparent with light text
 * and turns solid once the visitor scrolls (see scripts at the bottom of this file).
 */
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const settings = await getSettings();
const pathname = Astro.url.pathname;
const wa = whatsappUrl(settings);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,box-shadow,color] duration-500"
  data-overlay={overlay ? 'true' : 'false'}
>
  <div class="wrap flex h-[4.5rem] items-center justify-between gap-4 lg:h-[5.5rem]">
    <a href="/" class="inline-flex min-h-12 items-center" aria-label={`${settings.siteName} - home`}>
      <span class="logo-dark"><Logo settings={settings} tone="dark" /></span>
      <span class="logo-light"><Logo settings={settings} tone="light" /></span>
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-10 xl:gap-12">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link inline-flex min-h-11 items-center text-[0.7rem] font-semibold uppercase tracking-[0.26em] no-underline"
                aria-current={isActive(item.href, pathname) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={wa}
        target="_blank"
        rel="noopener noreferrer"
        class="wa-pill hidden lg:inline-flex"
        data-whatsapp
      >
        <Icon name="whatsapp" size={16} />
        <span>WhatsApp</span>
        <span class="sr-only"> (opens WhatsApp in a new tab)</span>
      </a>
      <button
        type="button"
        id="menu-toggle"
        class="header-icon inline-flex size-12 items-center justify-center lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <Icon name="menu" size={26} class="icon-open" />
        <Icon name="close" size={26} class="icon-close hidden" />
      </button>
    </div>
  </div>

  <!-- Mobile / tablet-portrait menu: a full-height editorial index -->
  <div id="mobile-menu" class="mobile-menu lg:hidden" hidden>
    <nav aria-label="Mobile" class="wrap flex min-h-full flex-col py-6">
      <ul class="flex-1">
        {
          NAV.map((item, i) => (
            <li class="border-b border-gold/25">
              <a
                href={item.href}
                class="menu-link flex min-h-[4.25rem] items-baseline gap-5 py-3 font-serif text-[2.4rem] leading-none tracking-tight no-underline xs:text-[2.8rem]"
                aria-current={isActive(item.href, pathname) ? 'page' : undefined}
              >
                <span class="w-8 shrink-0 font-sans text-[0.7rem] font-semibold tracking-[0.2em] text-gold-light" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mt-8">
        <a href={wa} target="_blank" rel="noopener noreferrer" class="btn btn-gold w-full" data-whatsapp>
          <Icon name="whatsapp" size={18} />
          <span>Chat on WhatsApp</span>
          <span class="sr-only"> (opens WhatsApp in a new tab)</span>
        </a>
        <p class="mt-5 text-center text-xs uppercase tracking-[0.2em] text-cream/70">{settings.serviceAreaNote}</p>
      </div>
    </nav>
  </div>
</header>

<style>
  /* Default (solid) state */
  #site-header {
    background: var(--color-cream);
    color: var(--color-ink);
    box-shadow: 0 1px 0 var(--color-line);
  }
  #site-header .logo-light { display: none; }
  .nav-link { position: relative; color: inherit; }
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0.6rem;
    height: 1px;
    background: var(--color-gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease-out-soft);
  }
  .nav-link:hover::after, .nav-link[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }

  /* WhatsApp pill: a quiet outlined control; the fill is reserved for the page's main CTA. */
  .wa-pill {
    align-items: center;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding: 0 1.25rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    text-decoration: none;
    color: inherit;
    border: 1px solid currentColor;
    background-image: linear-gradient(var(--color-gold), var(--color-gold));
    background-repeat: no-repeat;
    background-size: 0% 100%;
    transition: background-size 0.5s var(--ease-out-soft), color 0.3s, border-color 0.3s;
  }
  .wa-pill:hover { background-size: 100% 100%; color: var(--color-ink); border-color: var(--color-gold); }

  /* Transparent over the hero until scrolled */
  #site-header[data-overlay='true']:not(.is-scrolled):not(.menu-open) {
    background: transparent;
    box-shadow: none;
    color: var(--color-cream);
  }
  #site-header[data-overlay='true']:not(.is-scrolled):not(.menu-open) .logo-dark { display: none; }
  #site-header[data-overlay='true']:not(.is-scrolled):not(.menu-open) .logo-light { display: inline; }

  /* Open menu = dark panel */
  #site-header.menu-open {
    background: var(--color-night);
    color: var(--color-cream);
    box-shadow: none;
  }
  #site-header.menu-open .logo-dark { display: none; }
  #site-header.menu-open .logo-light { display: inline; }
  #site-header.menu-open :focus-visible { outline-color: var(--color-gold-light); }

  .mobile-menu {
    background: var(--color-night);
    color: var(--color-cream);
    height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .menu-link { transition: color 0.3s, padding-left 0.5s var(--ease-out-soft); }
  .menu-link:hover { padding-left: 0.75rem; }
  .menu-link[aria-current='page'] { color: var(--color-gold-light); font-style: italic; }
  .header-icon { color: inherit; }
</style>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle') as HTMLButtonElement;
  const menu = document.getElementById('mobile-menu')!;

  const setOpen = (open: boolean) => {
    menu.hidden = !open;
    header.classList.toggle('menu-open', open);
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    toggle.querySelector('.icon-open')!.classList.toggle('hidden', open);
    toggle.querySelector('.icon-close')!.classList.toggle('hidden', !open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };

  toggle.addEventListener('click', () => setOpen(!!menu.hidden));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !menu.hidden) {
      setOpen(false);
      toggle.focus();
    }
  });
  menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // Close if the viewport grows past the mobile breakpoint (e.g. rotating a tablet).
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));

  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 32);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
</script>
