---
import type { ImageMetadata } from 'astro';
import Img from './Img.astro';
import WhatsAppButton from './WhatsAppButton.astro';
import { emphasis, plain } from '../lib/text';

/**
 * Closing WhatsApp call to action. Left-aligned and oversized, with an optional photograph set beside
 * it, bleeding off the right edge of the page (it never sits behind the text, so contrast is never in question).
 */
interface Props {
  eyebrow?: string;
  heading: string;
  text: string;
  label?: string;
  message?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  source: string;
}
const { eyebrow, heading, text, label = 'Message us on WhatsApp', message, image, imageAlt = '', source } = Astro.props;
---

<section class="on-dark relative isolate overflow-hidden bg-moss text-cream">
  <div class="wrap section relative grid items-end gap-14 lg:grid-cols-12 lg:gap-10">
    <div class:list={[image ? 'lg:col-span-7' : 'lg:col-span-9']}>
      {eyebrow && <p class="eyebrow reveal">{eyebrow}</p>}
      <h2 class="h2 reveal mt-6 max-w-[14ch] !text-[clamp(2.6rem,5vw+0.4rem,5.2rem)]" style="--d:60ms" aria-label={plain(heading)} set:html={emphasis(heading)} />
      <div class="reveal mt-6 grid gap-10 md:grid-cols-12" style="--d:120ms">
        <p class="lead md:col-span-7">{text}</p>
      </div>
      <div class="reveal mt-8 flex flex-col gap-4 sm:flex-row" style="--d:180ms">
        <WhatsAppButton label={label} message={message} variant="ink" source={source} class="w-full sm:w-auto" />
        <a href="/contact/" class="btn btn-line w-full sm:w-auto">Send an enquiry</a>
      </div>
    </div>
    {
      image && (
        <div class="lg:col-span-5 lg:col-start-8 lg:-mr-[max(3.5rem,calc((100vw-88rem)/2+3.5rem))]">
          <Img src={image} alt={imageAlt} ratio={1} sizes="(min-width:1024px) 38vw, 90vw" widths={[480, 800, 1100]} reveal />
        </div>
      )
    }
  </div>
</section>
