---
import { getSettings } from '../lib/content';
import { whatsappUrl } from '../lib/contact';
import Icon from './Icon.astro';

/**
 * Persistent "Enquire" button, fixed bottom-right on every screen size. It opens a small menu with the two ways to
 * get in touch. It is a native <details> element, so it also opens without JavaScript; the script only adds
 * close-on-outside-click, Escape and close-after-choosing.
 *
 * Email: uses the business address when one is set in Site settings. Until then the option leads to the enquiry form
 * on the contact page, so it never points at an address that does not exist.
 */
const settings = await getSettings();
const email = settings.contact.email;
const emailHref = email
  ? `mailto:${email}?subject=${encodeURIComponent('Website enquiry')}&body=${encodeURIComponent(settings.contact.whatsappMessage)}`
  : '/contact/#enquiry-form';
const item = 'enq-item flex min-h-14 items-center gap-3.5 px-5 py-3.5 text-ink no-underline transition-colors hover:bg-cream-deep';
---

<details class="enq fixed z-40" data-enquire>
  <summary class="enq-btn inline-flex cursor-pointer list-none items-center gap-3 bg-ink text-cream">
    <span class="online-dot" aria-hidden="true"></span>
    <span class="text-[0.82rem] font-semibold uppercase tracking-[0.22em]">Enquire</span>
    <span class="enq-chevron" aria-hidden="true"></span>
    <span class="sr-only">: choose WhatsApp or email</span>
  </summary>

  <div class="enq-panel bg-cream" role="group" aria-label="Enquire by">
    <a href={whatsappUrl(settings)} target="_blank" rel="noopener noreferrer" class={item} data-whatsapp>
      <Icon name="whatsapp" size={24} class="shrink-0 text-gold-deep" />
      <span>
        <span class="block text-[0.78rem] font-semibold uppercase tracking-[0.18em]">WhatsApp</span>
        <span class="block text-xs text-muted">Quickest reply<span class="sr-only"> (opens in a new tab)</span></span>
      </span>
    </a>
    <a href={emailHref} class:list={[item, 'border-t border-line']}>
      <Icon name="mail" size={24} class="shrink-0 text-gold-deep" />
      <span>
        <span class="block text-[0.78rem] font-semibold uppercase tracking-[0.18em]">Email</span>
        <span class="block text-xs text-muted">{email ? 'Opens email app' : 'Send an enquiry'}</span>
      </span>
    </a>
  </div>
</details>

<style>
  .enq {
    right: max(1.25rem, env(safe-area-inset-right));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
  }
  .enq-btn {
    min-height: 3.5rem;
    padding: 0 1.4rem 0 1.25rem;
    border: 1px solid rgb(214 179 106 / 0.6);
    box-shadow: 0 0 0 3px rgb(214 179 106 / 0.18), 0 10px 28px -6px rgb(20 17 14 / 0.55);
    transition: transform 0.35s var(--ease-out-soft), border-color 0.3s, box-shadow 0.3s;
  }
  .enq-btn::-webkit-details-marker { display: none; }
  .enq-btn:hover {
    transform: translateY(-2px);
    border-color: var(--color-gold-light);
    box-shadow: 0 0 0 4px rgb(214 179 106 / 0.28), 0 14px 32px -6px rgb(20 17 14 / 0.65);
  }
  .enq-btn:focus-visible { outline: 2px solid var(--color-gold-light); outline-offset: 2px; }

  .enq-chevron {
    width: 0.55rem;
    height: 0.55rem;
    border-right: 1.5px solid var(--color-gold-light);
    border-top: 1.5px solid var(--color-gold-light);
    transform: rotate(-45deg) translate(-1px, 1px);
    transition: transform 0.35s var(--ease-out-soft);
  }
  .enq[open] .enq-chevron { transform: rotate(135deg) translate(-1px, 1px); }

  /* The menu opens upward from the button so it never runs off the bottom of the screen. */
  .enq-panel {
    position: absolute;
    right: 0;
    bottom: calc(100% + 0.65rem);
    width: min(18rem, calc(100vw - 2.5rem));
    border: 1px solid var(--color-gold);
    box-shadow: 0 16px 36px -10px rgb(20 17 14 / 0.5);
  }

  .online-dot {
    display: inline-block;
    width: 8.5px;
    height: 8.5px;
    border-radius: 50%;
    background: #22c55e;
    flex-shrink: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .online-dot { animation: enq-pulse 2s ease-in-out infinite; }
    @keyframes enq-pulse {
      0%, 100% { opacity: 1; transform: scale(1); }
      50% { opacity: 0.45; transform: scale(0.75); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .enq-btn, .enq-chevron { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-enquire]').forEach((box) => {
    const summary = box.querySelector('summary')!;
    document.addEventListener('click', (e) => {
      if (box.open && !box.contains(e.target as Node)) box.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && box.open) {
        box.open = false;
        summary.focus();
      }
    });
    // Close after a choice (small delay so the link still opens).
    box.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setTimeout(() => (box.open = false), 150)));
  });
</script>
