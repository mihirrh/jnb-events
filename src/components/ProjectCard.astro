---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  ratio?: number;
  sizes?: string;
  class?: string;
  delay?: number;
}
const { project, ratio = 4 / 5, sizes = '(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw', class: className, delay = 0 } = Astro.props;
const cover = project.data.images[0];
const count = project.data.images.length;
---

<a href={`/gallery/${project.id}/`} class:list={['group block no-underline', className]}>
  <Img src={cover.image} alt={cover.alt} ratio={ratio} sizes={sizes} class="media-zoom" reveal delay={delay} />
  <div class="mt-4 flex items-start justify-between gap-4">
    <div>
      <p class="text-[0.7rem] font-semibold uppercase tracking-[0.22em] text-gold-deep">{project.data.category}</p>
      <h3 class="h3 mt-1.5 transition-colors group-hover:text-gold-deep">{project.data.title}</h3>
    </div>
    <p class="mt-1 shrink-0 text-xs text-muted">{count} {count === 1 ? 'photo' : 'photos'}</p>
  </div>
</a>
