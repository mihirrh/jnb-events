---
import type { CollectionEntry } from 'astro:content';
import Img from './Img.astro';

/**
 * Project tile. The caption is set like a plate caption in a book: category and photo count in a
 * small-caps line, then the title. `index` adds a running plate number.
 */
interface Props {
  project: CollectionEntry<'projects'>;
  ratio?: number;
  sizes?: string;
  class?: string;
  delay?: number;
  index?: number;
}
const { project, ratio = 4 / 5, sizes = '(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw', class: className, delay = 0, index } = Astro.props;
const cover = project.data.images[0];
const count = project.data.images.length;
const plate = index === undefined ? undefined : String(index + 1).padStart(2, '0');
---

<a href={`/gallery/${project.id}/`} data-tilt class:list={['group block no-underline transition-transform duration-300', className]}>
  <Img src={cover.image} alt={cover.alt} ratio={ratio} sizes={sizes} class="media-zoom" reveal delay={delay} />
  <div class="mt-4 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2 border-b border-line pb-4">
    <div>
      <p class="text-[0.66rem] font-semibold uppercase tracking-[0.24em] text-gold-deep">
        {plate && <span class="mr-3 font-serif text-base normal-case italic tracking-normal">{plate}</span>}{project.data.category}
      </p>
      <h3 class="h3 mt-2 bg-[length:0%_1px] bg-left-bottom bg-no-repeat transition-[background-size] duration-500 [background-image:linear-gradient(var(--color-gold),var(--color-gold))] group-hover:bg-[length:100%_1px]">
        <span class="pb-1">{project.data.title}</span>
      </h3>
    </div>
    <p class="shrink-0 text-xs uppercase tracking-[0.18em] text-muted">{count}<span class="sr-only"> {count === 1 ? 'photo' : 'photos'}</span><span aria-hidden="true"> {count === 1 ? 'photo' : 'photos'}</span></p>
  </div>
</a>
