---
/**
 * JNB brand motif: a mandap arch (outer and inner arch on two pillars, standing on a base line).
 * Three variants share one geometry so they read as a family:
 *   line     - the arch alone. The default, and the only one that should be used at tiny sizes.
 *   floral   - the arch crowned with a small lotus bloom at the apex.
 *   monogram - the arch holding the letters JNB. For one or two prominent places only.
 *
 * Drawing rules: 1px hairline that never thickens when scaled (`vector-effect`), no fills, round caps.
 * Colour comes from `currentColor`: antique gold on light, light gold on `.on-dark` sections.
 * Decorative by default (aria-hidden); pass `label` if it ever carries meaning.
 */
interface Props {
  variant?: 'line' | 'floral' | 'monogram';
  /** Height in px; width follows the 4:5 viewBox. */
  size?: number;
  class?: string;
  label?: string;
}
const { variant = 'line', size = 56, class: className, label } = Astro.props;
const width = Math.round(size * 0.8);
---

<svg
  class:list={['motif', className]}
  viewBox="0 0 80 100"
  width={width}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {label && <title>{label}</title>}
  <g>
    <!-- base -->
    <path d="M8 92H72" vector-effect="non-scaling-stroke"></path>
    <!-- outer arch on two pillars -->
    <path d="M16 92V44a24 24 0 0 1 48 0v48" vector-effect="non-scaling-stroke"></path>
    <!-- inner arch, the canopy -->
    <path d="M26 92V46a14 14 0 0 1 28 0v46" opacity="0.55" vector-effect="non-scaling-stroke"></path>

    {
      variant === 'line' && (
        <>
          <!-- finial -->
          <path d="M40 20V12" vector-effect="non-scaling-stroke" />
          <circle cx="40" cy="9.5" r="1.6" vector-effect="non-scaling-stroke" />
        </>
      )
    }

    {
      variant === 'floral' && (
        <>
          <!-- lotus: one upright petal and two fanned out from the apex of the arch -->
          <path d="M40 3C44.5 8 44.5 14 40 20C35.5 14 35.5 8 40 3Z" vector-effect="non-scaling-stroke" />
          <path d="M40 3C44.5 8 44.5 14 40 20C35.5 14 35.5 8 40 3Z" transform="rotate(-48 40 20)" vector-effect="non-scaling-stroke" />
          <path d="M40 3C44.5 8 44.5 14 40 20C35.5 14 35.5 8 40 3Z" transform="rotate(48 40 20)" vector-effect="non-scaling-stroke" />
          <!-- two small buds on the pillars' capitals -->
          <circle cx="16" cy="44" r="1.3" vector-effect="non-scaling-stroke" />
          <circle cx="64" cy="44" r="1.3" vector-effect="non-scaling-stroke" />
        </>
      )
    }

    {
      variant === 'monogram' && (
        <>
          <path d="M40 20V12" vector-effect="non-scaling-stroke" />
          <circle cx="40" cy="9.5" r="1.6" vector-effect="non-scaling-stroke" />
          <text
            x="40"
            y="73"
            text-anchor="middle"
            font-family="'Bodoni Moda Variable','Bodoni 72',Didot,Georgia,serif"
            font-size="10.5"
            letter-spacing="1"
            fill="currentColor"
            stroke="none"
          >JNB</text>
        </>
      )
    }
  </g>
</svg>

<style>
  .motif { color: var(--color-gold); flex: none; }
  :global(.on-dark) .motif { color: var(--color-gold-light); }
</style>
