---
import { Image } from 'astro:assets';
import type { Settings } from '../lib/content';

/**
 * Brand mark. Uses the logo uploaded in the CMS if there is one; otherwise a typographic wordmark:
 * "JNB" in tracked Didone capitals with "Events" in italic beside it - no icon, no strapline in the
 * lock-up, so it reads as a name rather than a template logo. The strapline is offered separately
 * (`showTagline`) for the places that have room for it.
 */
interface Props { settings: Settings; tone?: 'dark' | 'light'; compact?: boolean; showTagline?: boolean; class?: string }
const { settings, tone = 'dark', compact = false, showTagline = false, class: className } = Astro.props;
const light = tone === 'light';
---

{
  settings.logo ? (
    <Image
      src={settings.logo}
      alt={settings.logoAlt ?? settings.siteName}
      height={compact ? 44 : 64}
      class:list={['h-auto w-auto max-h-12 sm:max-h-14', className]}
      loading="eager"
    />
  ) : (
    <span class:list={['logo-mark inline-flex flex-col items-center leading-none whitespace-nowrap', light && 'is-light', className]} role="img" aria-label={`${settings.siteName} - ${settings.tagline}`}>
      <span class:list={['logo-word flex items-baseline gap-[0.45em] font-serif', light ? 'text-cream' : 'text-ink']} aria-hidden="true">
        <span class="logo-jnb">JNB</span>
        <em class="logo-events">Events</em>
      </span>
      {
        showTagline && (
          <span class:list={['mt-2 text-[0.55rem] font-semibold uppercase tracking-[0.42em]', light ? 'text-gold-light' : 'text-gold-deep']} aria-hidden="true">
            {settings.tagline}
          </span>
        )
      }
    </span>
  )
}

<style>
  .logo-jnb { font-size: 1.7rem; letter-spacing: 0.2em; margin-right: -0.2em; color: var(--color-gold); }
  .logo-mark.is-light .logo-jnb { color: var(--color-gold-light); }
  .logo-events { font-size: 1.45rem; letter-spacing: -0.01em; font-weight: 400; }
  @media (min-width: 640px) {
    .logo-jnb { font-size: 1.95rem; }
    .logo-events { font-size: 1.65rem; }
  }
</style>
