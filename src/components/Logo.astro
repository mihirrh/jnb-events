---
import { Image } from 'astro:assets';
import wordmarkSvg from '../assets/brand/jnb-wordmark.svg?raw';
import lockupSvg from '../assets/brand/jnb-lockup.svg?raw';
import type { Settings } from '../lib/content';

/**
 * Brand mark. Uses the logo uploaded in the CMS if there is one; otherwise the JNB Events wordmark from
 * brand/jnb_logo.svg, inlined as vector so it takes its colour from CSS:
 *   - tone="dark"  the logo's own deep gold, for cream backgrounds
 *   - tone="light" light gold, for night backgrounds and photographs
 *   - tone="auto"  inherits `color` from the parent (the header recolours it as it changes state)
 * `showTagline` switches to the lock-up with "Decor . DJ . Mandaps" underneath, for places with room.
 * Regenerate the SVGs with `npm run build:brand`.
 */
interface Props { settings: Settings; tone?: 'dark' | 'light' | 'auto'; showTagline?: boolean; class?: string }
const { settings, tone = 'dark', showTagline = false, class: className } = Astro.props;

const raw = showTagline ? lockupSvg : wordmarkSvg;
const [, vw, vh] = raw.match(/viewBox="[-\d.]+ [-\d.]+ ([\d.]+) ([\d.]+)"/) ?? [];
const aspect = `${vw} / ${vh}`;
const svg = raw.replace('<svg ', '<svg focusable="false" ').trim();
const label = showTagline ? `${settings.siteName} - ${settings.tagline}` : settings.siteName;
---

{
  settings.logo ? (
    <Image
      src={settings.logo}
      alt={settings.logoAlt ?? settings.siteName}
      height={64}
      class:list={['h-auto w-auto max-h-12 sm:max-h-14', className]}
      loading="eager"
    />
  ) : (
    <span class:list={['logo-mark', `tone-${tone}`, showTagline && 'has-tagline', className]} style={`aspect-ratio:${aspect}`} role="img" aria-label={label} set:html={svg.replace(/ role="img" aria-label="[^"]*"/, ' aria-hidden="true"')} />
  )
}

<style is:global>
  .logo-mark { display: inline-block; height: 1.7rem; line-height: 0; vertical-align: middle; }
  .logo-mark svg { display: block; width: 100%; height: 100%; }
  .logo-mark.has-tagline { height: 3.4rem; }
  .logo-mark.tone-dark { color: var(--color-logo-gold); }
  .logo-mark.tone-light { color: var(--color-gold-light); }
  @media (min-width: 1024px) {
    .logo-mark { height: 2.15rem; }
    .logo-mark.has-tagline { height: 4rem; }
  }
</style>
