---
import { getSettings, getServices } from '../lib/content';
import { whatsappUrl, telUrl } from '../lib/contact';
import { NAV } from '../lib/nav';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import Sprig from './Sprig.astro';

const settings = await getSettings();
const services = await getServices();
const year = new Date().getFullYear();
---

<footer class="on-dark relative overflow-hidden bg-night text-cream">
  <Sprig class="pointer-events-none absolute -right-6 bottom-0 hidden h-80 text-gold/30 md:block" />
  <div class="wrap relative pt-20 pb-28 lg:pb-12">
    <div class="grid gap-14 md:grid-cols-12">
      <div class="md:col-span-5">
        <Logo settings={settings} tone="light" />
        <p class="mt-6 max-w-sm text-[0.95rem] leading-relaxed text-cream/75">{settings.description}</p>
        <p class="mt-4 flex items-start gap-2 text-sm text-cream/75">
          <Icon name="pin" size={18} class="mt-0.5 shrink-0 text-gold-light" />
          <span>{settings.serviceAreaNote}</span>
        </p>
      </div>

      <nav aria-label="Footer" class="md:col-span-2">
        <h2 class="eyebrow !text-gold-light">Explore</h2>
        <ul class="mt-5 space-y-1">
          {NAV.map((n) => (
            <li><a class="inline-flex min-h-11 items-center text-cream/85 no-underline hover:text-gold-light" href={n.href}>{n.label}</a></li>
          ))}
          <li><a class="inline-flex min-h-11 items-center text-cream/85 no-underline hover:text-gold-light" href="/privacy/">Privacy</a></li>
        </ul>
      </nav>

      <nav aria-label="Services" class="md:col-span-3">
        <h2 class="eyebrow !text-gold-light">Services</h2>
        <ul class="mt-5 space-y-1">
          {services.map((s) => (
            <li><a class="inline-flex min-h-11 items-center text-cream/85 no-underline hover:text-gold-light" href={`/services/${s.id}/`}>{s.data.title}</a></li>
          ))}
        </ul>
      </nav>

      <div class="md:col-span-2">
        <h2 class="eyebrow !text-gold-light">Contact</h2>
        <ul class="mt-5 space-y-1">
          <li>
            <a class="inline-flex min-h-11 items-center gap-2 text-cream/85 no-underline hover:text-gold-light" href={whatsappUrl(settings)} target="_blank" rel="noopener noreferrer">
              <Icon name="whatsapp" size={18} /> WhatsApp<span class="sr-only"> (opens in a new tab)</span>
            </a>
          </li>
          <li>
            <a class="inline-flex min-h-11 items-center gap-2 text-cream/85 no-underline hover:text-gold-light" href={telUrl(settings)}>
              <Icon name="phone" size={18} /> {settings.contact.whatsappNumber}
            </a>
          </li>
          {settings.contact.email && (
            <li>
              <a class="inline-flex min-h-11 items-center gap-2 break-all text-cream/85 no-underline hover:text-gold-light" href={`mailto:${settings.contact.email}`}>
                <Icon name="mail" size={18} /> {settings.contact.email}
              </a>
            </li>
          )}
          {settings.social.map((s) => (
            <li><a class="inline-flex min-h-11 items-center text-cream/85 no-underline hover:text-gold-light" href={s.url} target="_blank" rel="noopener noreferrer me">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-gold/30 pt-6 text-sm text-cream/60 sm:flex-row sm:justify-between">
      <p>&copy; {year} {settings.siteName}. All rights reserved.</p>
      <p>{settings.location.locality}, {settings.location.region} · Covering the UK</p>
    </div>
  </div>
</footer>
