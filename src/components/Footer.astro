---
import { getSettings, getServices } from '../lib/content';
import { whatsappUrl, telUrl } from '../lib/contact';
import { NAV } from '../lib/nav';
import Logo from './Logo.astro';
import Motif from './Motif.astro';

/**
 * Footer, composed like the last page of a brochure rather than a link directory:
 *  1. an invitation and the contact details set large,
 *  2. the services as a run-in index (a single flowing line of serif text, not a list of links),
 *  3. a colophon with the wordmark, area and small print.
 */
const settings = await getSettings();
const services = await getServices();
const year = new Date().getFullYear();
const small = 'inline-flex min-h-11 items-center text-[0.68rem] font-semibold uppercase tracking-[0.26em] text-cream/75 no-underline transition-colors hover:text-gold-light';
---

<footer class="on-dark relative bg-night text-cream" aria-label="Site footer">
  <div class="wrap pt-14 md:pt-20">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-7">
        <p class="eyebrow">Enquiries</p>
        <p class="mt-6 font-serif text-[clamp(2.1rem,3.6vw+0.4rem,3.9rem)] leading-[1.04] tracking-[-0.025em]">
          Your date, your venue &mdash; <em>our attention to detail.</em>
        </p>
      </div>

      <address class="not-italic lg:col-span-4 lg:col-start-9 lg:self-end">
        <a
          href={telUrl(settings)}
          class="num block py-2 text-[clamp(1.7rem,2vw+1rem,2.5rem)] leading-none no-underline transition-colors hover:text-gold-light"
        >{settings.contact.whatsappNumber}</a>
        {
          settings.contact.email && (
            <a href={`mailto:${settings.contact.email}`} class="mt-4 block break-all text-[0.98rem] text-cream/80 no-underline hover:text-gold-light">{settings.contact.email}</a>
          )
        }
        <a href={whatsappUrl(settings)} target="_blank" rel="noopener noreferrer" class="link-arrow mt-4" data-whatsapp>
          <span>Message on WhatsApp<span class="sr-only"> (opens in a new tab)</span></span><span aria-hidden="true">&rarr;</span>
        </a>
        <p class="mt-5 max-w-xs text-sm leading-relaxed text-cream/70">{settings.serviceAreaNote}</p>
      </address>
    </div>

    <div class="mt-12 flex items-center gap-6 md:mt-14" aria-hidden="true">
      <div class="hairline flex-1"></div>
      <Motif variant="line" size={44} />
      <div class="hairline flex-1"></div>
    </div>

    <div class="grid gap-8 py-8 lg:grid-cols-12 lg:gap-8 lg:py-10">
      <nav aria-label="Services" class="lg:col-span-8">
        <p class="folio"><span>Services</span><i aria-hidden="true"></i></p>
        <ul class="mt-6 font-serif text-[clamp(1.3rem,1vw+1rem,1.75rem)] leading-[1.7] tracking-[-0.01em]">
          {
            services.map((s) => (
              <li class="inline">
                <a href={`/services/${s.id}/`} class="runin text-cream no-underline">{s.data.title}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav aria-label="Footer" class="lg:col-span-3 lg:col-start-10">
        <p class="folio"><span>Index</span><i aria-hidden="true"></i></p>
        <ul class="mt-4 flex flex-wrap gap-x-8 lg:block">
          {NAV.map((n) => <li><a class={small} href={n.href}>{n.label}</a></li>)}
          {settings.social.map((s) => (
            <li><a class={small} href={s.url} target="_blank" rel="noopener noreferrer me">{s.label}<span class="sr-only"> (opens in a new tab)</span></a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="flex flex-col items-start gap-6 border-t border-gold/25 py-8 pb-28 lg:flex-row lg:items-center lg:justify-between lg:pb-8">
      <a href="/" class="inline-flex min-h-11 items-center" aria-label={`${settings.siteName} - home`}><Logo settings={settings} tone="light" showTagline /></a>
      <p class="text-[0.68rem] uppercase tracking-[0.22em] text-cream/65">
        &copy; {year} {settings.siteName} &middot; {settings.location.locality}, {settings.location.region} &middot; Serving the UK
        &nbsp;&middot;&nbsp; <a href="/privacy/" class="text-cream/80 underline decoration-gold/60 underline-offset-4 hover:text-gold-light">Privacy</a>
      </p>
    </div>
  </div>
</footer>

<style>
  /* Run-in index: titles flow as one line of type, separated by a fine gold slash. */
  .runin { position: relative; transition: color 0.3s; }
  .runin:hover { color: var(--color-gold-light); }
  li.inline:not(:last-child)::after {
    content: '/';
    margin-inline: 0.7em;
    color: var(--color-gold-light);
    opacity: 0.6;
  }
</style>
