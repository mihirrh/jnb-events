---
/**
 * One editable line item of the quote builder. Rendered once per starting item on the server (so the page is
 * complete without JavaScript) and once inside a <template> that the script clones for "Add line item".
 */
interface Props {
  index: number;
  description?: string;
  price?: number;
  free?: boolean;
}
const { index, description = '', price = 0, free = false } = Astro.props;
const n = index + 1;
---

<li class="q-row grid grid-cols-[1fr_auto] items-end gap-x-4 gap-y-1 border-t border-line py-4 md:grid-cols-[1fr_9rem_auto_auto] md:gap-x-6" data-row>
  <div class="field col-span-2 md:col-span-1">
    <label for={`q-desc-${n}`} data-label="desc">Item {n}</label>
    <input id={`q-desc-${n}`} type="text" maxlength="140" value={description} placeholder="Description" data-desc />
  </div>
  <div class="field">
    <label for={`q-price-${n}`} data-label="price">Price (&pound;)</label>
    <input id={`q-price-${n}`} type="text" inputmode="decimal" autocomplete="off" value={free ? '' : price.toFixed(2)} placeholder={free ? 'Free' : '0.00'} disabled={free} data-price />
  </div>
  <label class="inline-flex min-h-11 cursor-pointer items-center gap-2 pb-px text-sm text-ink-soft md:self-end">
    <input type="checkbox" class="size-5 accent-[var(--color-gold-deep)]" checked={free} data-free />
    <span>Free</span>
  </label>
  <button
    type="button"
    class="col-span-2 inline-flex min-h-11 min-w-11 items-center justify-self-start text-[0.68rem] md:col-span-1 md:justify-center md:justify-self-auto font-semibold uppercase tracking-[0.2em] text-muted underline decoration-line underline-offset-4 transition-colors hover:text-ink md:self-end md:no-underline"
    data-remove
  >Remove<span class="sr-only" data-label="remove"> item {n}</span></button>
</li>
